---
import { SCHEDULING_POLICY, UNATTENDED_POLICY } from '../../data/servicePolicy.js';
import { Icon } from 'astro-icon/components';
import { PRICE_FLOOR, PRICE_FLOOR_DETAIL } from '../../data/booking.js';
import Layout from '../../layouts/Layout.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import { services, getServiceSlugs } from '../../data/services.js';
import { businessNode } from '../../data/schemaBusiness.js';
import { cities } from '../../data/cities.js';
import { pickPhotos, buildAlt } from '../../data/photos.js';
import { serviceAngles, faqSchema } from '../../data/comboContent.js';

export function getStaticPaths() {
  return getServiceSlugs().map((slug) => ({
    params: { slug },
    props: { service: services[slug], slug },
  }));
}

const { service, slug } = Astro.props;
const phoneDisplay = '(952) 232-5107';
const smsLink = 'sms:+19522325107';
const canonical = `https://dakotavalleyjunkremovalservice.com/services/${slug}/`;
const ctaSms = `${smsLink}?&body=${encodeURIComponent(`${service.name} request.\nPlease send photos and item details.`)}`;
const popularCities = Object.entries(cities).slice(0, 12);
const heroPhoto = pickPhotos(slug, 1)[0];

// Per-service FAQ — statewide phrasing. Answers are sourced from booking.js
// (price floor, scheduling) and comboContent.js serviceAngles (disposal chain),
// so every claim is backed by an existing single-source-of-truth file.
const lc = service.name.toLowerCase();
const angle = serviceAngles[slug] || {};
const faqs = [
  {
    q: `How much does ${lc} cost in Minnesota?`,
    a: "Eligible curbside, driveway or accessible-garage pickups have an $85 minimum. This is not a flat price for every item. Send photos for the exact total in writing before booking. The written quote covers the items, volume, weight, access and disposal needs shown in your photos and details. When those match, the approved total stays the same. Any change to the agreed scope requires a revised quote that you approve before work begins.",
  },
  {
    q: `How do I book ${lc}?`,
    a: `Text photos of the items plus your city to (952) 232-5107, or use the photo-quote helper. The crew sends a firm quote and a pickup window — there is no on-site estimate visit.`,
  },
  {
    q: `How soon can you schedule ${lc}?`,
    a: SCHEDULING_POLICY,
  },
  {
    q: `Do I need to be home for ${lc}?`,
    a: UNATTENDED_POLICY,
  },
  {
    q: `Where do you offer ${lc}?`,
    a: `Across all Minnesota cities and counties, with route-aware scheduling. Coverage is heaviest across the Twin Cities metro — Hennepin, Ramsey, Dakota, Anoka, Washington, Scott, and Carver counties.`,
  },
];
if (angle.disposal) {
  faqs.push({
    q: `What happens to the items after ${lc}?`,
    a: `Donation-first. ${angle.disposal}`,
  });
}

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    businessNode,
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://dakotavalleyjunkremovalservice.com/' },
        { '@type': 'ListItem', position: 2, name: 'Services', item: 'https://dakotavalleyjunkremovalservice.com/#services' },
        { '@type': 'ListItem', position: 3, name: service.name },
      ],
    },
    {
      '@type': 'Service',
      name: service.name,
      provider: { '@id': 'https://dakotavalleyjunkremovalservice.com/#business' },
      areaServed: [
        { '@type': 'State', name: 'Minnesota' },
        { '@type': 'AdministrativeArea', name: 'Dakota County' },
        { '@type': 'AdministrativeArea', name: 'Hennepin County' },
        { '@type': 'AdministrativeArea', name: 'Ramsey County' },
      ],
      description: service.intro,
      serviceType: service.name,
      hasOfferCatalog: {
        '@type': 'OfferCatalog',
        name: `${service.name} options`,
        itemListElement: service.services.map((s) => ({
          '@type': 'Offer',
          itemOffered: { '@type': 'Service', name: s },
        })),
      },
    },
    faqSchema(faqs),
  ],
};
---
<Layout title={service.metaTitle} description={service.metaDescription} canonical={canonical} schema={schema}>
  <main>
    <section class="city-hero">
      <nav class="nav" aria-label="Primary navigation">
        <a class="brand" href="/"><span class="brand-mark"><Icon name="lucide:truck" size={22} /></span><span>Dakota Valley</span></a>
        <a class="nav-call" href={smsLink}><Icon name="lucide:message-square-text" size={18} /> Text {phoneDisplay}</a>
      </nav>
      <div class="city-hero-content">
        <p class="breadcrumb">
          <a href="/">Home</a> <span aria-hidden="true"> / </span>
          <a href="/#services">Services</a> <span aria-hidden="true"> / </span>
          <span>{service.name}</span>
        </p>
        <h1><span class="city-accent">{service.name}</span></h1>
        <p class="hero-copy">{service.headline}</p>
        <p class="hero-copy" style="margin-top: 0">{service.intro}</p>
        <p class="hero-copy" data-service-scope>Curbside, driveway and accessible-garage pickup only. No inside-home pickup.</p>
        <div class="hero-actions">
          <a class="button primary" href={ctaSms}><Icon name="lucide:message-square-text" size={18} /> Text photos to start</a>
          <span class="price-floor"><Icon name="lucide:tag" size={14} />{PRICE_FLOOR}</span>
          <a class="button secondary" href="/#quote"><Icon name="lucide:camera" size={18} /> Use the quote helper</a>
        </div>
      </div>
    </section>

    <figure class="city-hero-image">
      <img
        src={heroPhoto.src}
        width={heroPhoto.width}
        height={heroPhoto.height}
        alt={`${heroPhoto.desc} — ${service.name} across Minnesota — Dakota Valley Junk Removal`}
        loading="eager"
        fetchpriority="high"
      />
    </figure>

    <section class="section city-services">
      <div class="section-head"><div>
        <p class="section-kicker">What's included</p>
        <h2>{service.name} options</h2>
      </div></div>
      <div class="city-service-grid">
        {service.services.map((s) => (
          <article class="city-service-card">
            <span class="city-service-icon"><Icon name="lucide:check-circle-2" size={20} /></span>
            <h3>{s}</h3>
          </article>
        ))}
      </div>
    </section>

    <section class="section">
      <div class="section-head"><div>
        <p class="section-kicker">How it works</p>
        <h2>Four steps, mostly text.</h2>
      </div></div>
      <div class="city-service-grid">
        {service.process.map((step, i) => (
          <article class="city-service-card">
            <span class="city-service-icon">{i + 1}</span>
            <h3>Step {i + 1}</h3>
            <p>{step}</p>
          </article>
        ))}
      </div>
    </section>

    <section class="section city-locale">
      <div class="section-head"><div>
        <p class="section-kicker">{service.name} cities</p>
        <h2>Available across Minnesota.</h2>
      </div></div>
      <div class="city-grid">
        {popularCities.map(([sl, c]) => (
          <a href={`/cities/${sl}/${slug}/`} class="city-link">{c.name}</a>
        ))}
        <a href="/#areas" class="city-link">See all 61 cities</a>
      </div>
    </section>

    <section class="section">
      <div class="section-head"><div>
        <p class="section-kicker">FAQ</p>
        <h2>{service.name} — quick answers.</h2>
      </div></div>
      <div class="faq-list">
        {faqs.map(({ q, a }, index) => (
          <details class="faq-card" open={index === 0}>
            <summary>{ q }</summary>
            <p>{ a }</p>
          </details>
        ))}
      </div>
    </section>

    <section class="section city-cta">
      <div>
        <h2>Need {service.name.toLowerCase()}?</h2>
        <p>Text photos, item details, and a preferred pickup window. The crew confirms and handles the rest.</p>
      </div>
      <div class="hero-actions">
        <a class="button primary" href={ctaSms}><Icon name="lucide:message-square-text" size={18} /> Text {phoneDisplay}</a>
          <span class="price-floor"><Icon name="lucide:tag" size={14} />{PRICE_FLOOR}</span>
        <a class="button secondary" href="/#quote">Use the quote helper</a>
      </div>
    </section>

    <SiteFooter />
    <div class="mobile-cta">
      <a class="button primary" href={ctaSms}>Text</a>
      <a class="button secondary" href="/#quote">Book</a>
    </div>
  </main>
</Layout>
