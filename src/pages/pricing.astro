---
import { Icon } from 'astro-icon/components';
import { PRICE_FLOOR } from '../data/booking.js';
import Layout from '../layouts/Layout.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { businessNode, BUSINESS_ID } from '../data/schemaBusiness.js';

const phoneDisplay = '(952) 232-5107';
const smsLink = 'sms:+19522325107';
const site = 'https://dakotavalleyjunkremovalservice.com';
const canonical = `${site}/pricing/`;

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    businessNode,
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Home', item: `${site}/` },
        { '@type': 'ListItem', position: 2, name: 'Pricing' },
      ],
    },
    {
      '@type': 'Offer',
      '@id': `${site}/#minimum-pickup`,
      name: 'Junk removal pickup minimum',
      description: 'Eligible curbside or garage junk-removal pickups have an $85 minimum. Exact totals are quoted from customer photos before booking.',
      url: canonical,
      offeredBy: { '@id': BUSINESS_ID },
      itemOffered: { '@type': 'Service', name: 'Junk removal' },
      price: '85',
      priceCurrency: 'USD',
      availability: 'https://schema.org/InStock',
    },
  ],
};
---
<Layout
  title="Junk Removal Pricing Minnesota | $85 Minimum | Dakota Valley"
  description="Dakota Valley Junk Removal has an $85 minimum for eligible curbside or garage pickups. Text photos for an exact written quote before you book—no confusing load chart or surprise on-site price change."
  canonical={canonical}
  schema={schema}
>
  <main>
    <section class="city-hero">
      <nav class="nav"><a class="brand" href="/"><span class="brand-mark"><Icon name="lucide:truck" size={22} /></span><span>Dakota Valley</span></a>
        <a class="nav-call" href={smsLink} data-track="sms_click"><Icon name="lucide:message-square-text" size={18} /> Text {phoneDisplay}</a></nav>
      <div class="city-hero-content">
        <p class="breadcrumb"><a href="/">Home</a> <span> / </span><span>Pricing</span></p>
        <h1><span class="city-accent">$85 minimum.</span> Your exact quote comes from photos.</h1>
        <p class="hero-copy">We do not use a one-size-fits-all truck chart or a low headline price that changes at the curb. Send clear photos, receive the total in writing, and decide before choosing a pickup window.</p>
        <div class="hero-actions">
          <a class="button primary" href={smsLink} data-track="sms_click"><Icon name="lucide:camera" size={18} /> Text photos for an exact quote</a>
          <span class="price-floor"><Icon name="lucide:tag" size={14} />{PRICE_FLOOR}</span>
          <a class="button secondary" href="/#quote"><Icon name="lucide:clipboard-check" size={18} /> Use the quote helper</a>
        </div>
      </div>
    </section>

    <section class="section">
      <div class="section-head"><div>
        <p class="section-kicker">What the minimum means</p>
        <h2>Competitive starting point. Job-specific final total.</h2>
      </div>
        <p class="hero-copy" style="max-width:680px">The $85 minimum applies to eligible curbside or garage pickups. The exact quote depends on what is being removed and what the job requires.</p>
      </div>
      <div class="city-service-grid">
        <article class="city-service-card">
          <span class="city-service-icon"><Icon name="lucide:tag" size={20} /></span>
          <h3>$85 pickup minimum</h3>
          <p>Our only published price—simple, clear, and easy to compare.</p>
        </article>
        <article class="city-service-card">
          <span class="city-service-icon"><Icon name="lucide:badge-check" size={20} /></span>
          <h3>Written before booking</h3>
          <p>Your photo quote is sent in writing so you can approve the total before the crew is scheduled.</p>
        </article>
        <article class="city-service-card">
          <span class="city-service-icon"><Icon name="lucide:camera" size={20} /></span>
          <h3>Based on the real job</h3>
          <p>Volume, weight, access, labor, and specialty disposal needs can affect the final quote.</p>
        </article>
        <article class="city-service-card">
          <span class="city-service-icon"><Icon name="lucide:recycle" size={20} /></span>
          <h3>Responsible routing</h3>
          <p>Reusable and recyclable items are routed responsibly whenever practical instead of automatically going to a landfill.</p>
        </article>
      </div>
    </section>

    <section class="section whytext" aria-label="How to compare junk removal quotes">
      <div class="section-head"><div>
        <p class="section-kicker">Compare the total—not the teaser</p>
        <h2>A low advertised number is not always the lowest final bill.</h2>
      </div></div>
      <div class="whytext-cols">
        <article class="whytext-card whytext-them">
          <h3>Watch for</h3>
          <ul>
            <li><Icon name="lucide:alert-circle" size={16} /> A starter price that covers almost nothing</li>
            <li><Icon name="lucide:circle-help" size={16} /> A quote that is not confirmed until arrival</li>
            <li><Icon name="lucide:plus-circle" size={16} /> Unclear labor, access, or disposal add-ons</li>
            <li><Icon name="lucide:clock" size={16} /> An on-site sales process that takes more of your day</li>
          </ul>
        </article>
        <article class="whytext-card whytext-us">
          <h3>The Dakota Valley approach</h3>
          <ul>
            <li><Icon name="lucide:message-square-text" size={16} /> Send photos instead of scheduling an estimate visit</li>
            <li><Icon name="lucide:badge-check" size={16} /> Receive the quoted total in writing</li>
            <li><Icon name="lucide:calendar-check" size={16} /> Choose a real pickup window after reviewing the quote</li>
            <li><Icon name="lucide:shield-check" size={16} /> Work with a local, licensed and insured company</li>
          </ul>
          <a class="button primary" href={smsLink} data-track="sms_click"><Icon name="lucide:camera" size={18} /> Text photos now</a>
        </article>
      </div>
    </section>

    <section class="section city-cta">
      <div>
        <h2>Ready for the exact number?</h2>
        <p>Text 3–5 clear photos, your city, and where the items are located. We will send a written quote and available pickup window.</p>
      </div>
      <div class="hero-actions">
        <a class="button primary" href={smsLink} data-track="sms_click"><Icon name="lucide:message-square-text" size={18} /> Text {phoneDisplay}</a>
        <span class="price-floor"><Icon name="lucide:tag" size={14} />{PRICE_FLOOR}</span>
        <a class="button secondary" href="/#quote">Use the quote helper</a>
      </div>
    </section>

    <SiteFooter />
    <div class="mobile-cta">
      <a class="button primary" href={smsLink} data-track="sms_click">Text</a>
      <a class="button secondary" href="/#quote">Book</a>
    </div>
  </main>
</Layout>
