---
import { Icon } from 'astro-icon/components';
import { PRICE_FLOOR } from '../../data/booking.js';
import Layout from '../../layouts/Layout.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import { guides } from '../../data/allGuides.js';
import { businessNode } from '../../data/schemaBusiness.js';

const site = 'https://dakotavalleyjunkremovalservice.com';
const canonical = `${site}/guides/`;
const phoneDisplay = '(952) 232-5107';
const smsLink = 'sms:+19522325107';
const sortedGuides = Object.entries(guides).sort(([, a], [, b]) => (b.priority || 0) - (a.priority || 0));

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    businessNode,
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Home', item: `${site}/` },
        { '@type': 'ListItem', position: 2, name: 'Guides' },
      ],
    },
    {
      '@type': 'CollectionPage',
      name: 'Minnesota junk removal, recycling and disposal guides',
      url: canonical,
      hasPart: sortedGuides.map(([slug, guide]) => ({
        '@type': 'Article',
        headline: guide.title,
        url: `${site}/guides/${slug}/`,
        datePublished: guide.datePublished,
        dateModified: guide.dateModified || guide.datePublished,
      })),
    },
  ],
};
---
<Layout
  title="Minnesota Junk Removal & Disposal Guides | Eagan and Dakota County"
  description="Local guides for mattress, furniture, appliance, electronics, hazardous-waste, yard-waste, recycling-center and dump searches in Eagan, Apple Valley and Dakota County."
  canonical={canonical}
  schema={schema}
>
  <main>
    <section class="city-hero">
      <nav class="nav" aria-label="Primary navigation">
        <a class="brand" href="/"><span class="brand-mark"><Icon name="lucide:truck" size={22} /></span><span>Dakota Valley</span></a>
        <a class="nav-call" href={smsLink} data-track="sms_click"><Icon name="lucide:message-square-text" size={18} /> Text {phoneDisplay}</a>
      </nav>
      <div class="city-hero-content">
        <p class="breadcrumb">
          <a href="/">Home</a> <span aria-hidden="true"> / </span>
          <span>Guides</span>
        </p>
        <h1>Local disposal answers for <span class="city-accent">Minnesota</span></h1>
        <p class="hero-copy">
          Clear, sourced guidance for the questions residents actually search: where to take mattresses, furniture,
          appliances, electronics, yard waste and hazardous materials—and when pickup is easier than self-hauling.
        </p>
      </div>
    </section>

    <section class="section">
      <div class="section-head"><div>
        <p class="section-kicker">Eagan, Apple Valley and Dakota County</p>
        <h2>Find the right disposal route before loading your vehicle.</h2>
      </div>
        <p class="section-copy">Each guide separates public drop-off information from Dakota Valley pickup services and links to current official resources.</p>
      </div>
      <div class="city-service-grid">
        {sortedGuides.map(([slug, guide]) => (
          <a href={`/guides/${slug}/`} class="city-service-card">
            <span class="city-service-icon"><Icon name="lucide:book-open" size={20} /></span>
            {guide.category && <p class="section-kicker" style="margin:0 0 6px">{guide.category}</p>}
            <h3>{guide.title}</h3>
            <p>{guide.metaDescription}</p>
          </a>
        ))}
      </div>
    </section>

    <section class="section city-cta">
      <div>
        <h2>Have bulky non-hazardous items?</h2>
        <p>Text clear photos for a written pickup quote. Hazardous materials must use an approved county disposal program.</p>
      </div>
      <div class="hero-actions">
        <a class="button primary" href={smsLink} data-track="sms_click"><Icon name="lucide:message-square-text" size={18} /> Text {phoneDisplay}</a>
        <span class="price-floor"><Icon name="lucide:tag" size={14} />{PRICE_FLOOR}</span>
      </div>
    </section>

    <SiteFooter />
    <div class="mobile-cta">
      <a class="button primary" href={smsLink} data-track="sms_click">Text</a>
      <a class="button secondary" href="/#quote">Book</a>
    </div>
  </main>
</Layout>
