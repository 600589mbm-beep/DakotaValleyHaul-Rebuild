---
import { Icon } from 'astro-icon/components';
import { PRICE_FLOOR } from '../../data/booking.js';
import Layout from '../../layouts/Layout.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import { guides } from '../../data/guides.js';
import { businessNode } from '../../data/schemaBusiness.js';

const site = 'https://dakotavalleyjunkremovalservice.com';
const canonical = `${site}/guides/`;
const phoneDisplay = '(952) 232-5107';
const smsLink = 'sms:+19522325107';

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    businessNode,
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Home', item: `${site}/` },
        { '@type': 'ListItem', position: 2, name: 'Guides' },
      ],
    },
    {
      '@type': 'CollectionPage',
      name: 'Junk removal guides for Minnesota',
      url: canonical,
      hasPart: Object.entries(guides).map(([slug, g]) => ({
        '@type': 'Article',
        headline: g.title,
        url: `${site}/guides/${slug}/`,
        datePublished: g.datePublished,
      })),
    },
  ],
};
---
<Layout
  title="Junk Removal Guides for Minnesota | Costs, Disposal Rules, Checklists | Dakota Valley"
  description="Practical Minnesota disposal guides: what junk removal costs, how to get rid of mattresses and appliances, garage cleanout planning, and what haulers won't take."
  canonical={canonical}
  schema={schema}
>
  <main>
    <section class="city-hero">
      <nav class="nav" aria-label="Primary navigation">
        <a class="brand" href="/"><span class="brand-mark"><Icon name="lucide:truck" size={22} /></span><span>Dakota Valley</span></a>
        <a class="nav-call" href={smsLink}><Icon name="lucide:message-square-text" size={18} /> Text {phoneDisplay}</a>
      </nav>
      <div class="city-hero-content">
        <p class="breadcrumb">
          <a href="/">Home</a> <span aria-hidden="true"> / </span>
          <span>Guides</span>
        </p>
        <h1>Junk removal guides for <span class="city-accent">Minnesota</span></h1>
        <p class="hero-copy">
          What things cost, where they're allowed to go, and how to plan a cleanout that finishes in one weekend —
          written from the disposal rules and pricing we work with every day.
        </p>
      </div>
    </section>

    <section class="section">
      <div class="city-service-grid">
        {Object.entries(guides).map(([slug, g]) => (
          <a href={`/guides/${slug}/`} class="city-service-card">
            <span class="city-service-icon"><Icon name="lucide:book-open" size={20} /></span>
            <h3>{g.title}</h3>
            <p>{g.metaDescription}</p>
          </a>
        ))}
      </div>
    </section>

    <section class="section city-cta">
      <div>
        <h2>Skip the reading — just text photos.</h2>
        <p>A firm quote and a pickup window come back by text, usually within hours.</p>
      </div>
      <div class="hero-actions">
        <a class="button primary" href={smsLink}><Icon name="lucide:message-square-text" size={18} /> Text {phoneDisplay}</a>
        <span class="price-floor"><Icon name="lucide:tag" size={14} />{PRICE_FLOOR}</span>
      </div>
    </section>

    <SiteFooter />
    <div class="mobile-cta">
      <a class="button primary" href={smsLink}>Text</a>
      <a class="button secondary" href="/#quote">Book</a>
    </div>
  </main>
</Layout>
