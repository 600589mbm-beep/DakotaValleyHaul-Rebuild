---
import { Icon } from 'astro-icon/components';
import { PRICE_FLOOR } from '../../data/booking.js';
import Layout from '../../layouts/Layout.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import { guides, getGuideSlugs } from '../../data/guides.js';
import { businessNode } from '../../data/schemaBusiness.js';
import { faqSchema } from '../../data/comboContent.js';

export function getStaticPaths() {
  return getGuideSlugs().map((slug) => ({
    params: { slug },
    props: { guide: guides[slug], slug },
  }));
}

const { guide, slug } = Astro.props;
const site = 'https://dakotavalleyjunkremovalservice.com';
const canonical = `${site}/guides/${slug}/`;
const phoneDisplay = '(952) 232-5107';
const smsLink = 'sms:+19522325107';
const otherGuides = Object.entries(guides).filter(([s]) => s !== slug);

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    businessNode,
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Home', item: `${site}/` },
        { '@type': 'ListItem', position: 2, name: 'Guides', item: `${site}/guides/` },
        { '@type': 'ListItem', position: 3, name: guide.shortTitle },
      ],
    },
    {
      '@type': 'Article',
      headline: guide.title,
      description: guide.metaDescription,
      datePublished: guide.datePublished,
      dateModified: guide.datePublished,
      mainEntityOfPage: canonical,
      author: { '@id': `${site}/#business` },
      publisher: { '@id': `${site}/#business` },
      image: `${site}/og-card.png`,
    },
    faqSchema(guide.faqs),
  ],
};
---
<Layout title={guide.metaTitle} description={guide.metaDescription} canonical={canonical} schema={schema}>
  <main>
    <section class="city-hero">
      <nav class="nav" aria-label="Primary navigation">
        <a class="brand" href="/"><span class="brand-mark"><Icon name="lucide:truck" size={22} /></span><span>Dakota Valley</span></a>
        <a class="nav-call" href={smsLink}><Icon name="lucide:message-square-text" size={18} /> Text {phoneDisplay}</a>
      </nav>
      <div class="city-hero-content">
        <p class="breadcrumb">
          <a href="/">Home</a> <span aria-hidden="true"> / </span>
          <a href="/guides/">Guides</a> <span aria-hidden="true"> / </span>
          <span>{guide.shortTitle}</span>
        </p>
        <h1>{guide.title}</h1>
        <p class="hero-copy">{guide.intro}</p>
        <div class="hero-actions">
          <a class="button primary" href={smsLink}><Icon name="lucide:message-square-text" size={18} /> Text photos for a quote</a>
          <span class="price-floor"><Icon name="lucide:tag" size={14} />{PRICE_FLOOR}</span>
        </div>
      </div>
    </section>

    {guide.sections.map((section) => (
      <section class="section">
        <div class="section-head"><div>
          <h2>{section.h2}</h2>
        </div></div>
        {section.body.map((p) => <p class="section-copy" style="margin-bottom: 16px">{p}</p>)}
      </section>
    ))}

    <section class="section">
      <div class="section-head"><div>
        <p class="section-kicker">FAQ</p>
        <h2>Quick answers.</h2>
      </div></div>
      <div class="faq-list">
        {guide.faqs.map(({ q, a }, index) => (
          <details class="faq-card" open={index === 0}>
            <summary>{q}</summary>
            <p>{a}</p>
          </details>
        ))}
      </div>
    </section>

    <section class="section city-locale">
      <div class="section-head"><div>
        <p class="section-kicker">More guides</p>
        <h2>Keep reading.</h2>
      </div></div>
      <div class="city-grid">
        {otherGuides.map(([s, g]) => (
          <a href={`/guides/${s}/`} class="city-link">{g.shortTitle}</a>
        ))}
        <a href="/pricing/" class="city-link">Full pricing breakdown</a>
      </div>
    </section>

    <section class="section city-cta">
      <div>
        <h2>Ready to get it gone?</h2>
        <p>Text photos and your city — a firm quote and a pickup window come back by text, usually within hours.</p>
      </div>
      <div class="hero-actions">
        <a class="button primary" href={smsLink}><Icon name="lucide:message-square-text" size={18} /> Text {phoneDisplay}</a>
        <span class="price-floor"><Icon name="lucide:tag" size={14} />{PRICE_FLOOR}</span>
        <a class="button secondary" href="/#quote">Use the quote helper</a>
      </div>
    </section>

    <SiteFooter />
    <div class="mobile-cta">
      <a class="button primary" href={smsLink}>Text</a>
      <a class="button secondary" href="/#quote">Book</a>
    </div>
  </main>
</Layout>
