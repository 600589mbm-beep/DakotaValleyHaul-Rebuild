---
import { Icon } from 'astro-icon/components';
import { PRICE_FLOOR } from '../../data/booking.js';
import Layout from '../../layouts/Layout.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import { guides, getGuideSlugs } from '../../data/allGuides.js';
import { businessNode } from '../../data/schemaBusiness.js';
import { faqSchema } from '../../data/comboContent.js';

export function getStaticPaths() {
  return getGuideSlugs().map((slug) => ({
    params: { slug },
    props: { guide: guides[slug], slug },
  }));
}

const { guide, slug } = Astro.props;
const site = 'https://dakotavalleyjunkremovalservice.com';
const canonical = `${site}/guides/${slug}/`;
const phoneDisplay = '(952) 232-5107';
const smsLink = 'sms:+19522325107';
const otherGuides = Object.entries(guides)
  .filter(([guideSlug]) => guideSlug !== slug)
  .sort(([, a], [, b]) => (b.priority || 0) - (a.priority || 0))
  .slice(0, 12);
const modifiedDate = guide.dateModified || guide.datePublished;

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    businessNode,
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Home', item: `${site}/` },
        { '@type': 'ListItem', position: 2, name: 'Guides', item: `${site}/guides/` },
        { '@type': 'ListItem', position: 3, name: guide.shortTitle },
      ],
    },
    {
      '@type': 'Article',
      headline: guide.title,
      description: guide.metaDescription,
      datePublished: guide.datePublished,
      dateModified: modifiedDate,
      mainEntityOfPage: canonical,
      author: { '@id': `${site}/#business` },
      publisher: { '@id': `${site}/#business` },
      image: `${site}/og-card.png`,
      ...(guide.sources?.length
        ? { citation: guide.sources.map((source) => source.url) }
        : {}),
    },
    faqSchema(guide.faqs),
  ],
};
---
<Layout title={guide.metaTitle} description={guide.metaDescription} canonical={canonical} schema={schema}>
  <main>
    <section class="city-hero">
      <nav class="nav" aria-label="Primary navigation">
        <a class="brand" href="/"><span class="brand-mark"><Icon name="lucide:truck" size={22} /></span><span>Dakota Valley</span></a>
        <a class="nav-call" href={smsLink} data-track="sms_click"><Icon name="lucide:message-square-text" size={18} /> Text {phoneDisplay}</a>
      </nav>
      <div class="city-hero-content">
        <p class="breadcrumb">
          <a href="/">Home</a> <span aria-hidden="true"> / </span>
          <a href="/guides/">Guides</a> <span aria-hidden="true"> / </span>
          <span>{guide.shortTitle}</span>
        </p>
        {guide.category && <p class="section-kicker">{guide.category}</p>}
        <h1>{guide.title}</h1>
        <p class="hero-copy">{guide.intro}</p>
        <div class="hero-actions">
          <a class="button primary" href={smsLink} data-track="sms_click"><Icon name="lucide:message-square-text" size={18} /> Text photos for a quote</a>
          <span class="price-floor"><Icon name="lucide:tag" size={14} />{PRICE_FLOOR}</span>
          {guide.serviceLink && <a class="button secondary" href={guide.serviceLink}>{guide.serviceLabel || 'View related service'}</a>}
        </div>
        <p class="hero-meta"><Icon name="lucide:calendar-check" size={15} /> Information reviewed {modifiedDate}</p>
      </div>
    </section>

    {guide.sections.map((section) => (
      <section class="section">
        <div class="section-head"><div>
          <h2>{section.h2}</h2>
        </div></div>
        {section.body.map((paragraph) => <p class="section-copy" style="margin-bottom: 16px">{paragraph}</p>)}
      </section>
    ))}

    {guide.sources?.length > 0 && (
      <section class="section city-locale" aria-label="Official resources">
        <div class="section-head"><div>
          <p class="section-kicker">Verify before you drive</p>
          <h2>Official local resources.</h2>
        </div>
          <p class="section-copy">Facility hours, accepted materials and fees can change. Check the official source and call ahead when needed.</p>
        </div>
        <div class="city-grid">
          {guide.sources.map((source) => (
            <a href={source.url} class="city-link" target="_blank" rel="noopener noreferrer">
              {source.label} <Icon name="lucide:external-link" size={14} />
            </a>
          ))}
        </div>
      </section>
    )}

    <section class="section">
      <div class="section-head"><div>
        <p class="section-kicker">FAQ</p>
        <h2>Quick answers.</h2>
      </div></div>
      <div class="faq-list">
        {guide.faqs.map(({ q, a }, index) => (
          <details class="faq-card" open={index === 0}>
            <summary>{q}</summary>
            <p>{a}</p>
          </details>
        ))}
      </div>
    </section>

    <section class="section city-locale">
      <div class="section-head"><div>
        <p class="section-kicker">More local guides</p>
        <h2>Keep reading.</h2>
      </div></div>
      <div class="city-grid">
        {otherGuides.map(([guideSlug, relatedGuide]) => (
          <a href={`/guides/${guideSlug}/`} class="city-link">{relatedGuide.shortTitle}</a>
        ))}
        <a href="/guides/" class="city-link">View all disposal guides</a>
      </div>
    </section>

    <section class="section city-cta">
      <div>
        <h2>Need bulky non-hazardous items removed?</h2>
        <p>Text photos and your city for a written quote and pickup window. Hazardous materials must use an approved county program.</p>
      </div>
      <div class="hero-actions">
        <a class="button primary" href={smsLink} data-track="sms_click"><Icon name="lucide:message-square-text" size={18} /> Text {phoneDisplay}</a>
        <span class="price-floor"><Icon name="lucide:tag" size={14} />{PRICE_FLOOR}</span>
        <a class="button secondary" href="/#quote">Use the quote helper</a>
      </div>
    </section>

    <SiteFooter />
    <div class="mobile-cta">
      <a class="button primary" href={smsLink} data-track="sms_click">Text</a>
      <a class="button secondary" href="/#quote">Book</a>
    </div>
  </main>
</Layout>
