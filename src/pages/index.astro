---
import { Icon } from 'astro-icon/components';
import Layout from '../layouts/Layout.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { cities } from '../data/cities.js';
import { counties as countiesData } from '../data/counties.js';
import { services } from '../data/services.js';
import { photos } from '../data/photos.js';
import { iconForService } from '../data/serviceIcons.js';
import TelegramForm from '../components/TelegramForm.astro';
import { PRICE_FLOOR, PRICE_FLOOR_DETAIL } from '../data/booking.js';

const homeHeroPhoto = photos[0]; // canonical "lead" photo
const homeGalleryPhotos = photos.slice(1, 4); // 3 supporting shots

const phoneDisplay = '(952) 232-5107';
const smsLink = 'sms:+19522325107';
const email = 'info@dakotavalleyjunkremovalservice.com';

const allCountyNames = [
  'Aitkin', 'Anoka', 'Becker', 'Beltrami', 'Benton', 'Big Stone', 'Blue Earth', 'Brown', 'Carlton', 'Carver', 'Cass',
  'Chippewa', 'Chisago', 'Clay', 'Clearwater', 'Cook', 'Cottonwood', 'Crow Wing', 'Dakota', 'Dodge', 'Douglas',
  'Faribault', 'Fillmore', 'Freeborn', 'Goodhue', 'Grant', 'Hennepin', 'Houston', 'Hubbard', 'Isanti', 'Itasca',
  'Jackson', 'Kanabec', 'Kandiyohi', 'Kittson', 'Koochiching', 'Lac qui Parle', 'Lake', 'Lake of the Woods',
  'Le Sueur', 'Lincoln', 'Lyon', 'Mahnomen', 'Marshall', 'Martin', 'McLeod', 'Meeker', 'Mille Lacs', 'Morrison',
  'Mower', 'Murray', 'Nicollet', 'Nobles', 'Norman', 'Olmsted', 'Otter Tail', 'Pennington', 'Pine', 'Pipestone',
  'Polk', 'Pope', 'Ramsey', 'Red Lake', 'Redwood', 'Renville', 'Rice', 'Rock', 'Roseau', 'St. Louis', 'Scott',
  'Sherburne', 'Sibley', 'Stearns', 'Steele', 'Stevens', 'Swift', 'Todd', 'Traverse', 'Wabasha', 'Wadena', 'Waseca',
  'Washington', 'Watonwan', 'Wilkin', 'Winona', 'Wright', 'Yellow Medicine',
];
const countySlugsWithPages = new Set(Object.keys(countiesData));

const homepageSchema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization',
      '@id': 'https://dakotavalleyjunkremovalservice.com/#organization',
      name: 'Dakota Valley Junk Removal',
      url: 'https://dakotavalleyjunkremovalservice.com',
      logo: 'https://dakotavalleyjunkremovalservice.com/favicon.svg',
      sameAs: [
        'https://www.facebook.com/dakotavalleyjunkremoval',
        'https://www.yelp.com/biz/dakota-valley-junk-removal-eagan',
      ],
    },
    {
      '@type': 'LocalBusiness',
      '@id': 'https://dakotavalleyjunkremovalservice.com/#business',
      parentOrganization: { '@id': 'https://dakotavalleyjunkremovalservice.com/#organization' },
      name: 'Dakota Valley Junk Removal',
      url: 'https://dakotavalleyjunkremovalservice.com',
      telephone: '+1-952-232-5107',
      email: 'info@dakotavalleyjunkremovalservice.com',
      priceRange: 'From $85',
      image: 'https://dakotavalleyjunkremovalservice.com/attached_assets/IMG_7020_1750653174383.jpeg',
      address: {
        '@type': 'PostalAddress',
        streetAddress: '1964 Rahncliff Ct, Ste 200, #22342',
        addressLocality: 'Eagan',
        addressRegion: 'MN',
        postalCode: '55122',
        addressCountry: 'US',
      },
      geo: { '@type': 'GeoCoordinates', latitude: 44.8041, longitude: -93.1666 },
      areaServed: [
        { '@type': 'State', name: 'Minnesota' },
        { '@type': 'AdministrativeArea', name: 'Dakota County' },
        { '@type': 'AdministrativeArea', name: 'Hennepin County' },
        { '@type': 'AdministrativeArea', name: 'Ramsey County' },
      ],
      serviceType: ['Curbside junk pickup', 'Garage junk pickup', 'Furniture removal', 'Appliance recycling', 'Yard waste removal', 'Estate cleanout'],
      founder: { '@type': 'Person', name: 'Dakota Valley Team' },
      foundingDate: '2009',
      knowsAbout: ['Junk removal', 'Furniture removal', 'Appliance recycling', 'Estate cleanout', 'Yard waste'],
      sameAs: [
        'https://www.facebook.com/dakotavalleyjunkremoval',
        'https://www.yelp.com/biz/dakota-valley-junk-removal-eagan',
      ],
      openingHoursSpecification: {
        '@type': 'OpeningHoursSpecification',
        dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday', 'Sunday'],
        opens: '08:00',
        closes: '21:00',
      },
      aggregateRating: {
        '@type': 'AggregateRating',
        ratingValue: '5.0',
        reviewCount: '6',
        bestRating: '5',
        worstRating: '1',
      },
    },
    {
      '@type': 'WebSite',
      '@id': 'https://dakotavalleyjunkremovalservice.com/#website',
      url: 'https://dakotavalleyjunkremovalservice.com',
      name: 'Dakota Valley Junk Removal',
      publisher: { '@id': 'https://dakotavalleyjunkremovalservice.com/#business' },
      inLanguage: 'en-US',
    },
    {
      '@type': 'FAQPage',
      '@id': 'https://dakotavalleyjunkremovalservice.com/#faq',
      mainEntity: [
        { '@type': 'Question', name: 'What is the minimum pickup price?', acceptedAnswer: { '@type': 'Answer', text: 'The minimum pickup price is $85 for eligible curbside or garage pickup. Final pricing depends on volume, weight, dump fees, and specialty disposal.' } },
        { '@type': 'Question', name: 'Why curbside and garage only?', acceptedAnswer: { '@type': 'Answer', text: 'This keeps labor time low, helps the crew move faster, and lets Dakota Valley pass savings directly back to customers.' } },
        { '@type': 'Question', name: 'Do I need to call?', acceptedAnswer: { '@type': 'Answer', text: 'No. Text and the booking form are preferred. Photos, item details, city or county, and your preferred calendar window are usually enough to start.' } },
        { '@type': 'Question', name: 'Do you serve my city or county?', acceptedAnswer: { '@type': 'Answer', text: 'Yes. Dakota Valley is set up for all Minnesota cities and counties, with route-aware scheduling based on your location.' } },
        { '@type': 'Question', name: 'When is the soonest you can pick up?', acceptedAnswer: { '@type': 'Answer', text: 'Appointments are typically scheduled about two business days out so the crew is prepared with the right equipment. Most customers book within 2-3 business days. Text or use the booking form to check current availability.' } },
        { '@type': 'Question', name: 'Do I need to be home during the pickup?', acceptedAnswer: { '@type': 'Answer', text: 'No, as long as the items are accessible at the curb or in the garage. The crew calls before arrival and sends a confirmation photo when the job is complete.' } },
        { '@type': 'Question', name: 'What items do you remove?', acceptedAnswer: { '@type': 'Answer', text: 'Furniture, appliances, mattresses, yard waste, construction debris, exercise equipment, office furniture, and general household items. Larger jobs like hot tubs and estate cleanouts are quoted by request.' } },
        { '@type': 'Question', name: 'What items do you NOT accept?', acceptedAnswer: { '@type': 'Answer', text: 'For safety and legal reasons, hazardous waste (paint, chemicals, pesticides, motor oil), medical waste, asbestos, biological waste, and explosives. If unsure about an item, text a photo first.' } },
        { '@type': 'Question', name: 'Do you recycle or donate items?', acceptedAnswer: { '@type': 'Answer', text: 'Yes. Furniture in good condition goes to Bridging, Arc\'s Value Village, and Goodwill Twin Cities. Electronics go to R2-certified recyclers. Mattresses are recycled at certified Minnesota facilities. Target is 60%+ diverted from landfill.' } },
        { '@type': 'Question', name: 'How long does junk removal take?', acceptedAnswer: { '@type': 'Answer', text: 'Most residential pickups take 30-90 minutes depending on volume. Full estate cleanouts may take 2-4 hours. The crew works efficiently and never rushes - the property is left clean.' } },
      ],
    },
  ],
};

const faqs = [
  { q: 'What is the minimum pickup price?', a: 'The minimum pickup price is $85 for eligible curbside or garage pickup. Final pricing depends on volume, weight, dump fees, and specialty disposal.' },
  { q: 'Why curbside and garage only?', a: 'This keeps labor time low, helps the crew move faster, and lets Dakota Valley pass savings directly back to customers.' },
  { q: 'Do I need to call?', a: 'No. Text and the booking form are preferred. Photos, item details, city or county, and your preferred calendar window are usually enough to start.' },
  { q: 'Do you serve my city or county?', a: 'Yes. Dakota Valley is set up for all Minnesota cities and counties, with route-aware scheduling based on your location.' },
  { q: 'When is the soonest you can pick up?', a: 'Appointments are typically scheduled about two business days out so the crew is prepared with the right equipment. Most customers book within 2–3 business days. Text or use the booking form to check current availability.' },
  { q: 'Do I need to be home during the pickup?', a: 'No — as long as the items are accessible at the curb or in the garage. The crew calls before arrival and sends a confirmation photo when the job is complete.' },
  { q: 'What items do you remove?', a: 'Furniture, appliances, mattresses, yard waste, construction debris, exercise equipment, office furniture, and general household items. Larger jobs like hot tubs and estate cleanouts are quoted by request — send photos to start.' },
  { q: 'What items do you NOT accept?', a: 'For safety and legal reasons, hazardous waste (paint, chemicals, pesticides, motor oil), medical waste, asbestos, biological waste, and explosives. If unsure about an item, text a photo first.' },
  { q: 'Do you recycle or donate items?', a: 'Yes. Furniture in good condition goes to Bridging, Arc\'s Value Village, and Goodwill Twin Cities. Electronics go to R2-certified recyclers. Mattresses are recycled at certified Minnesota facilities. Target is 60%+ diverted from landfill.' },
  { q: 'How long does junk removal take?', a: 'Most residential pickups take 30–90 minutes depending on volume. Full estate cleanouts may take 2–4 hours. The crew works efficiently and never rushes — the property is left clean.' },
];
---
<Layout
  title="Dakota Valley Junk Removal | Curbside and Garage Pickup"
  description="Dakota Valley Junk Removal offers affordable curbside and garage junk pickup across Minnesota with an $85 minimum, text-first photo quotes, and calendar booking."
  canonical="https://dakotavalleyjunkremovalservice.com/"
  schema={homepageSchema}
>
  <main>
    <section class="hero" id="top">
      <nav class="nav" aria-label="Primary navigation">
        <a class="brand" href="#top">
          <span class="brand-mark"><Icon name="lucide:truck" size={22} /></span>
          <span>Dakota Valley</span>
        </a>
        <div class="nav-links">
          <a href="#services">Services</a>
          <a href="/pricing/">Pricing</a>
          <a href="#areas">Areas</a>
          <a href="#about">About</a>
          <a href="#faq">FAQ</a>
        </div>
        <a class="nav-call" href={smsLink}><Icon name="lucide:message-square-text" size={18} /> Text {phoneDisplay}</a>
      </nav>
      <div class="hero-content">
        <p class="eyebrow"><Icon name="lucide:sparkles" size={16} /> Minnesota junk removal, cleaned up</p>
        <h1>Dakota Valley Junk Removal</h1>
        <p class="hero-copy">
          <strong>Same-day eligible curbside and garage junk pickup across Minnesota.</strong>
          Text photos, get a firm quote in hours, pick a calendar window. $85 minimum, no phone call required.
        </p>
        <div class="hero-actions">
          <a class="button primary" href={smsLink}><Icon name="lucide:message-square-text" size={18} /> Text a photo quote</a>
          <span class="price-floor"><Icon name="lucide:tag" size={14} />{PRICE_FLOOR}</span>
          <a class="button secondary" href="#quote"><Icon name="lucide:send" size={18} /> Send booking form</a>
          <a class="button ghost" href="#areas"><Icon name="lucide:map-pin" size={18} /> Check service area</a>
        </div>
        <div class="hero-proof" aria-label="Business highlights">
          <span><Icon name="lucide:check-circle-2" size={16} /> $85 minimum pickup</span>
          <span><Icon name="lucide:camera" size={16} /> Photo estimates by text or form</span>
          <span><Icon name="lucide:home" size={16} /> Curbside and garage only</span>
        </div>
      </div>
    </section>

    <figure class="city-hero-image">
      <img
        src={homeHeroPhoto.src}
        width={homeHeroPhoto.width}
        height={homeHeroPhoto.height}
        alt={`${homeHeroPhoto.desc} — Dakota Valley Junk Removal serving Minneapolis, St. Paul, and Minnesota`}
        loading="eager"
        fetchpriority="high"
      />
    </figure>

    <section class="band metrics" aria-label="Key service stats">
      <div><strong>$85</strong><span>Minimum pickup</span></div>
      <div><strong>{Object.keys(services).length}</strong><span>Service categories</span></div>
      <div><strong>{Object.keys(cities).length}</strong><span>Cities served</span></div>
      <div><strong>Since 2009</strong><span>Locally owned</span></div>
    </section>

    <section class="band trust-grid" aria-label="Trust signals">
      <article>
        <h3><Icon name="lucide:shield-check" size={20} /> Licensed and insured</h3>
        <p>Fully licensed for waste hauling. General liability insurance covers your property during pickup.</p>
      </article>
      <article>
        <h3><Icon name="lucide:calendar-days" size={20} /> Same-day eligible</h3>
        <p>Most pickups scheduled within 2-3 business days. Same-day jobs available based on crew capacity.</p>
      </article>
      <article>
        <h3><Icon name="lucide:recycle" size={20} /> 60%+ diverted from landfill</h3>
        <p>Furniture donated to Bridging, Arc, Goodwill. Electronics to R2-certified recyclers. Mattresses recycled.</p>
      </article>
      <article>
        <h3><Icon name="lucide:check-circle-2" size={20} /> Transparent pricing</h3>
        <p>$85 minimum. Volume-based tiers. Surcharges disclosed upfront. <a href="/pricing/">See pricing</a>.</p>
      </article>
    </section>

    <section class="section split" id="services">
      <div>
        <p class="section-kicker">Services</p>
        <h2>Built for the jobs people actually put off.</h2>
        <p class="section-copy">
          Pick the service that matches your situation. Keeping pickup to curbside and garage jobs lowers labor time so savings can go back to customers.
        </p>
        <div class="service-list">
          {Object.entries(services).slice(0, 6).map(([slug, s]) => (
            <a href={`/services/${slug}/`} class="service-row">
              <span class="icon-box"><Icon name={iconForService(slug)} size={22} /></span>
              <span><strong>{s.name}</strong><small>{s.headline}</small></span>
            </a>
          ))}
        </div>
        <div class="service-deep-links" aria-label="Service pages">
          {Object.entries(services).map(([slug, s]) => (
            <a href={`/services/${slug}/`} class="service-deep-link">{s.name} →</a>
          ))}
        </div>
      </div>

      <aside class="quote-card" id="quote">
        <p class="section-kicker" id="pricing">Booking form</p>
        <h3>Send a booking, get a window</h3>
        <p>
          <strong>{PRICE_FLOOR_DETAIL}</strong>
        </p>
        <TelegramForm />
      </aside>
    </section>

    <section class="section tight" id="items">
      <div class="section-head"><div>
        <p class="section-kicker">What we take</p>
        <h2>From one bulky item to a full property reset.</h2>
      </div>
        <p class="section-copy">Stage items at the curb or in the garage. Mention anything heavy, sharp, oversized, or unusual when requesting a quote.</p>
      </div>
      <div class="take-grid">
        <article class="take-card"><h3>Furniture & home goods</h3><p>Sofas, beds, dressers, dining sets, exercise equipment.</p></article>
        <article class="take-card"><h3>Appliances</h3><p>Refrigerators (refrigerant recovered), washers, dryers, stoves.</p></article>
        <article class="take-card"><h3>Yard & construction debris</h3><p>Brush, fencing, deck debris, light remodel debris.</p></article>
        <article class="take-card"><h3>Estate & garage cleanouts</h3><p>Full property resets. Donations routed to Bridging, Arc, Goodwill.</p></article>
      </div>
    </section>

    <section class="areas-v2" id="areas">
      <header class="areas-head">
        <p class="section-kicker">Service areas</p>
        <h2>One statewide brand, local routes that make sense.</h2>
        <p class="section-copy">
          Dakota Valley serves all Minnesota cities and counties with route-aware scheduling and practical curbside or garage pickup.
        </p>
      </header>

      <div class="areas-search">
        <label for="areas-search-input" class="sr-only">Search Minnesota cities and counties</label>
        <input
          id="areas-search-input"
          type="search"
          class="areas-search-input"
          placeholder="Search your city or county"
          aria-controls="areas-cities-list areas-counties-list"
        />
        <button type="button" class="areas-search-clear" id="areas-search-clear" aria-label="Clear search" style="display: none">×</button>
      </div>

      <div class="areas-featured" role="group" aria-label="Featured counties and statewide">
        <a href="/counties/dakota-county/" class="areas-pill">Dakota County</a>
        <a href="/counties/hennepin-county/" class="areas-pill">Hennepin County</a>
        <a href="/counties/ramsey-county/" class="areas-pill">Ramsey County</a>
        <a href="/counties/washington-county/" class="areas-pill">Washington County</a>
        <a href="/counties/scott-county/" class="areas-pill">Scott County</a>
        <a href="/counties/olmsted-county/" class="areas-pill">Olmsted County</a>
        <a href="/counties/st-louis-county/" class="areas-pill">St. Louis County</a>
        <button type="button" class="areas-pill areas-pill-allmn" id="areas-allmn-button">All Minnesota</button>
      </div>

      <div aria-live="polite" class="sr-only" id="areas-filter-announce"></div>

      <details class="areas-accordion" id="areas-cities-details">
        <summary><h3>View all {Object.keys(cities).length} Minnesota cities</h3></summary>
        <div class="areas-link-grid" id="areas-cities-list">
          {Object.entries(cities).map(([slug, c]) => (
            <a href={`/cities/${slug}/`} class="areas-link" data-areas-name={c.name.toLowerCase()}>{c.name}</a>
          ))}
        </div>
      </details>

      <details class="areas-accordion" id="areas-counties-details">
        <summary><h3>View all 87 Minnesota counties</h3></summary>
        <div class="areas-link-grid" id="areas-counties-list">
          {allCountyNames.map((county) => {
            const slug = county.toLowerCase().replace(/[. ]+/g, '-') + '-county';
            const hasPage = countySlugsWithPages.has(slug);
            const text = `${county} County`;
            return hasPage
              ? <a href={`/counties/${slug}/`} class="areas-link" data-areas-name={text.toLowerCase()}>{text}</a>
              : <span class="areas-link areas-link-text" data-areas-name={text.toLowerCase()}>{text}</span>;
          })}
        </div>
      </details>
    </section>

    <section class="section process">
      <p class="section-kicker">How it works</p>
      <h2>Three steps from clutter to clear.</h2>
      <div class="steps">
        <article><span class="step-number">1</span><h3>Text photos</h3><p>Send a few shots of the items + your city or county.</p></article>
        <article><span class="step-number">2</span><h3>Confirm quote</h3><p>Crew sends a firm quote and a pickup window via text.</p></article>
        <article><span class="step-number">3</span><h3>We haul</h3><p>Stage items curbside or in the garage. Crew arrives, loads, sweeps.</p></article>
      </div>
    </section>

    <section class="section about" id="about">
      <div class="section-head"><div>
        <p class="section-kicker">About Dakota Valley</p>
        <h2>Twin Cities-grown since 2009.</h2>
      </div></div>
      <div class="about-grid">
        <div class="about-body">
          <p>Dakota Valley Junk Removal started in 2009 with one truck serving Uptown Minneapolis and Highland Park St. Paul. The routes now reach the full metro and beyond, but the principles haven't changed: honest pricing, exceptional service, and environmental responsibility.</p>
          <p>Donation partners include <strong>Bridging</strong>, <strong>Arc's Value Village</strong>, and <strong>Goodwill Twin Cities</strong>. Through county recycling programs in Hennepin, Ramsey, and Dakota, more than 60% of materials are diverted from landfills.</p>
          <p>Locally-owned. The team lives in the same communities it serves — from Edina to Eagan to Northeast Minneapolis. Every job gets the same care, whether it's a Kenwood mansion or a Frogtown bungalow.</p>
        </div>
        <div class="about-stats">
          <div class="about-stat"><div class="about-stat-number">60%+</div><div class="about-stat-label">Materials diverted from landfill</div></div>
          <div class="about-stat"><div class="about-stat-number">44+</div><div class="about-stat-label">Tons diverted annually</div></div>
          <div class="about-stat"><div class="about-stat-number">15+</div><div class="about-stat-label">Local charity partners</div></div>
        </div>
      </div>
    </section>

    <section class="section" id="faq">
      <div class="section-head"><div>
        <p class="section-kicker">FAQ</p>
        <h2>Quick answers before someone texts.</h2>
      </div></div>
      <div class="faq-list">
        {faqs.map((faq, index) => (
          <details class="faq-card" open={index === 0}>
            <summary>{faq.q}</summary>
            <p>{faq.a}</p>
          </details>
        ))}
      </div>
    </section>

    <SiteFooter />

    <div class="mobile-cta">
      <a class="button primary" href={smsLink}>Text</a>
      <a class="button secondary" href="#quote">Book</a>
    </div>
  </main>

  <!-- Areas filter — vanilla JS, hydrates the static accordions for live search -->
  <script>
    (function () {
      const input = document.getElementById('areas-search-input');
      const clearBtn = document.getElementById('areas-search-clear');
      const citiesDetails = document.getElementById('areas-cities-details');
      const countiesDetails = document.getElementById('areas-counties-details');
      const allMnBtn = document.getElementById('areas-allmn-button');
      const announce = document.getElementById('areas-filter-announce');
      if (!input) return;

      const cityLinks = document.querySelectorAll('#areas-cities-list [data-areas-name]');
      const countyLinks = document.querySelectorAll('#areas-counties-list [data-areas-name]');

      let timeout;
      function filter() {
        const q = input.value.trim().toLowerCase();
        let cityCount = 0, countyCount = 0;
        cityLinks.forEach((el) => {
          const match = !q || el.dataset.areasName.includes(q);
          el.style.display = match ? '' : 'none';
          if (match) cityCount++;
        });
        countyLinks.forEach((el) => {
          const match = !q || el.dataset.areasName.includes(q);
          el.style.display = match ? '' : 'none';
          if (match) countyCount++;
        });
        if (q) {
          citiesDetails.open = true;
          countiesDetails.open = true;
        }
        clearBtn.style.display = q ? 'grid' : 'none';
        if (announce) {
          announce.textContent = q
            ? (cityCount + countyCount === 0 ? 'No matches' : `Showing ${cityCount} cities and ${countyCount} counties`)
            : '';
        }
      }
      input.addEventListener('input', () => {
        clearTimeout(timeout);
        timeout = setTimeout(filter, 100);
      });
      clearBtn.addEventListener('click', () => {
        input.value = '';
        filter();
        input.focus();
      });
      allMnBtn.addEventListener('click', () => {
        citiesDetails.open = true;
        countiesDetails.open = true;
        citiesDetails.scrollIntoView({ behavior: 'smooth', block: 'start' });
      });
    })();
  </script>
</Layout>
