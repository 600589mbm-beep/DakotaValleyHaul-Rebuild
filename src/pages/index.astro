---
import SiteNav from '../components/SiteNav.astro';
import ServiceAreaFinder from '../components/ServiceAreaFinder.astro';
import { COVERAGE_POLICY, QUOTE_POLICY, SCHEDULING_POLICY, UNATTENDED_POLICY } from '../data/servicePolicy.js';
import { Icon } from 'astro-icon/components';
import Layout from '../layouts/Layout.astro';
import SiteFooter from '../components/SiteFooter.astro';
import TelegramForm from '../components/TelegramForm.astro';
import TrustBar from '../components/TrustBar.astro';
import Testimonials from '../components/Testimonials.astro';
import BeforeAfter from '../components/BeforeAfter.astro';
import PricingPreview from '../components/PricingPreview.astro';
import ImpactChart from '../components/ImpactChart.astro';
import HeavyItems from '../components/HeavyItems.astro';
import { cities } from '../data/cities.js';
import { services } from '../data/services.js';
import { counties } from '../data/counties.js';
import { guides } from '../data/guides.js';
import { iconForService, startingPriceForService } from '../data/serviceIcons.js';
import { PRICE_FLOOR_DETAIL } from '../data/pricing.js';
import reviewsData from '../data/reviews.json';
import { businessNode, SAME_AS } from '../data/schemaBusiness.js';

const phoneDisplay = '(952) 232-5107';
const smsLink = 'sms:+19522325107';
const email = 'info@dakotavalleyjunkremovalservice.com';
const site = 'https://dakotavalleyjunkremovalservice.com';

const agg = reviewsData.aggregate || { ratingValue: 5.0, reviewCount: 0 };
const topServices = Object.entries(services).slice(0, 6);
const restServices = Object.entries(services).slice(6);

const faqs = [
  { q: 'What is the minimum pickup price?', a: "Eligible curbside, driveway or accessible-garage pickups have an $85 minimum. This is not a flat price for every item. Send photos for the exact total in writing before booking. The written quote covers the items, volume, weight, access and disposal needs shown in your photos and details. When those match, the approved total stays the same. Any change to the agreed scope requires a revised quote that you approve before work begins." },
  { q: 'Why do you quote from photos?', a: 'Photos show the actual volume, item type, access, and disposal needs. That lets the crew give you a more accurate written quote without scheduling an on-site sales visit.' },
  { q: 'Will the price change when the crew arrives?', a: QUOTE_POLICY },
  { q: 'Do you serve my city or county?', a: COVERAGE_POLICY },
  { q: 'When is the soonest you can pick up?', a: SCHEDULING_POLICY },
  { q: 'Do I need to be home during pickup?', a: UNATTENDED_POLICY },
  { q: 'What items do you remove?', a: 'Furniture, appliances, mattresses, yard waste, construction debris, exercise equipment, office furniture, and general household items. Larger jobs such as hot tubs and estate cleanouts are quoted from photos.' },
  { q: 'What items do you not accept?', a: 'For safety and legal reasons, hazardous waste, medical waste, asbestos, biological waste, and explosives are not accepted. Text a photo first when you are unsure.' },
  { q: 'Do you recycle or donate items?', a: 'Yes. Usable furniture and household goods are routed to donation partners when practical, while electronics, mattresses, metal, and compostable material are sent to appropriate recycling or processing facilities.' },
];

const businessId = `${site}/#business`;

const serviceSchema = Object.entries(services).map(([slug, service]) => ({
  '@type': 'Service',
  '@id': `${site}/services/${slug}/#service`,
  name: service.name,
  description: service.metaDescription || service.intro,
  serviceType: service.name,
  provider: { '@id': businessId },
  areaServed: { '@type': 'State', name: 'Minnesota' },
  url: `${site}/services/${slug}/`,
}));

const minimumOffer = {
  '@type': 'Offer',
  '@id': `${site}/#minimum-pickup`,
  name: 'Junk removal pickup minimum',
  description: 'Eligible curbside or garage junk-removal pickups have an $85 minimum. Exact totals are quoted from customer photos before booking.',
  price: '85',
  priceCurrency: 'USD',
  availability: 'https://schema.org/InStock',
  itemOffered: { '@type': 'Service', name: 'Junk removal' },
  offeredBy: { '@id': businessId },
};

const homepageSchema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization',
      '@id': `${site}/#organization`,
      name: 'Dakota Valley Junk Removal',
      url: site,
      logo: `${site}/favicon.svg`,
      sameAs: SAME_AS,
    },
    {
      ...businessNode,
      parentOrganization: { '@id': `${site}/#organization` },
      areaServed: [
        { '@type': 'State', name: 'Minnesota' },
        { '@type': 'AdministrativeArea', name: 'Dakota County' },
        { '@type': 'AdministrativeArea', name: 'Hennepin County' },
        { '@type': 'AdministrativeArea', name: 'Ramsey County' },
      ],
      makesOffer: { '@id': `${site}/#minimum-pickup` },
      knowsAbout: ['Junk removal', 'Furniture removal', 'Appliance recycling', 'Estate cleanout', 'Yard waste'],
    },
    minimumOffer,
    ...serviceSchema,
    {
      '@type': 'WebSite',
      '@id': `${site}/#website`,
      url: site,
      name: 'Dakota Valley Junk Removal',
      publisher: { '@id': businessId },
      inLanguage: 'en-US',
    },
    {
      '@type': 'FAQPage',
      '@id': `${site}/#faq`,
      mainEntity: faqs.map((faq) => ({
        '@type': 'Question',
        name: faq.q,
        acceptedAnswer: { '@type': 'Answer', text: faq.a },
      })),
    },
  ],
};
---
<Layout
  title="Minnesota Junk Removal & Photo Quotes | Dakota Valley"
  description="Get a written quote for curbside, driveway or garage junk pickup in Minnesota. Eligible pickups have an $85 minimum. Approve the price before confirming pickup."
  canonical="https://dakotavalleyjunkremovalservice.com/"
  schema={homepageSchema}
>
  <main>
    <section class="hero" id="top">
      <SiteNav />

      <div class="dv-hero-grid">
        <div class="dv-hero-copy">
          <span class="dv-eyebrow"><span class="dv-dot"></span> Locally owned Twin Cities junk removal</span>
          <h1 class="dv-h1">Clear the clutter.<br><span class="amber">Keep your day.</span></h1>
          <p class="dv-sub"><strong>Text photos and get the total in writing before you book.</strong> Curbside, driveway and accessible-garage pickup only. No inside-home pickup.</p>

          <div class="dv-actions">
            <a class="dv-btn dv-btn-amber" href={smsLink} data-track="sms_click"><Icon name="lucide:camera" size={19} /> Text photos for a quote</a>
            <a class="dv-btn dv-btn-ghost" href="#how">See how it works</a>
            <span class="dv-price-flag"><Icon name="lucide:tag" size={14} /> Pickup minimum <strong>$85</strong></span>
          </div>

          <div class="dv-trust">
            <span><Icon name="lucide:badge-check" size={16} /> Written quote before booking</span>
            <span><Icon name="lucide:shield-check" size={16} /> Licensed &amp; insured</span>
            <span><Icon name="lucide:recycle" size={16} /> Donation-first disposal</span>
          </div>
        </div>

        <div class="dv-phone" role="img" aria-label="Text exchange showing a customer sending a junk photo and Dakota Valley confirming that the exact quote will be sent in writing before booking. The pickup minimum is $85.">
          <span class="dv-notch" aria-hidden="true"></span>
          <div class="dv-thread">
            <div class="dv-thread-head">
              <span class="dv-av"><Icon name="lucide:truck" size={18} /></span>
              <span class="dv-who">Dakota Valley Junk<small>Example quote conversation</small></span>
            </div>
            <div class="dv-bubble dv-in">Can you take this couch and the boxes next to it in Eagan? 🛋️<span class="dv-t">2:14 PM</span></div>
            <div class="dv-photo" aria-hidden="true">
              <svg viewBox="0 0 200 120" xmlns="http://www.w3.org/2000/svg">
                <rect width="200" height="120" fill="#2b2018"/>
                <rect x="0" y="86" width="200" height="34" fill="#3a2c20"/>
                <rect x="22" y="48" width="92" height="40" rx="7" fill="#7d5a3c"/>
                <rect x="22" y="40" width="92" height="16" rx="7" fill="#946b48"/>
                <rect x="30" y="56" width="34" height="28" rx="4" fill="#5e4129"/>
                <rect x="72" y="56" width="34" height="28" rx="4" fill="#5e4129"/>
                <rect x="120" y="58" width="40" height="30" fill="#b59a6a" stroke="#8a7044" stroke-width="2"/>
                <rect x="124" y="62" width="40" height="30" fill="#c7ab78" stroke="#8a7044" stroke-width="2"/>
                <line x1="124" y1="77" x2="164" y2="77" stroke="#8a7044" stroke-width="2"/>
                <rect x="158" y="44" width="34" height="44" fill="#9c8050" stroke="#75603a" stroke-width="2"/>
                <circle cx="178" cy="22" r="13" fill="#f0a92e" opacity=".22"/>
              </svg>
            </div>
            <div class="dv-bubble dv-out dv-r1"><span class="dv-quote">Yes. Pickup minimum is <span class="q">$85</span>. I’ll send the exact total in writing from these photos.</span><br>Which day works best?<span class="dv-t">2:31 PM</span></div>
            <div class="dv-bubble dv-in dv-r2">Would tomorrow morning work? Do I need to be home?<span class="dv-t">2:33 PM</span></div>
            <div class="dv-bubble dv-out dv-r3">We’ll confirm an available window. You can be away if we agree on safe curbside or garage access first ✅<span class="dv-t">2:34 PM</span></div>
            <div class="dv-typing" aria-hidden="true"><i></i><i></i><i></i></div>
          </div>
          <span class="dv-phone-tag">photo → written quote</span>
        </div>
      </div>
    </section>

    <div class="dv-marquee" aria-hidden="true">
      <div class="dv-marquee-track">
        <span>Furniture<span></span>Appliances<span></span>Mattresses<span></span>Garage cleanouts<span></span>Hot tubs<span></span>Yard debris<span></span>Estate cleanouts<span></span>Staged cleanout items<span></span>Single items<span></span></span>
        <span>Furniture<span></span>Appliances<span></span>Mattresses<span></span>Garage cleanouts<span></span>Hot tubs<span></span>Yard debris<span></span>Estate cleanouts<span></span>Staged cleanout items<span></span>Single items<span></span></span>
      </div>
    </div>

    <div class="band-wrap"><TrustBar aggregate={agg} verified={reviewsData.source === 'google'} /></div>

    <section class="band metrics" aria-label="Key service facts">
      <div><strong>$85</strong><span>Pickup minimum</span></div>
      <div><strong>Written</strong><span>Quote before booking</span></div>
      <div><strong>{Object.keys(cities).length}</strong><span>Cities served</span></div>
      <div><strong>Since 2023</strong><span>Locally owned</span></div>
    </section>

    <section class="section services-v2" id="services">
      <div class="section-head"><div>
        <p class="section-kicker">What we haul</p>
        <h2>One local crew for the jobs people keep putting off.</h2>
      </div>
        <p class="section-copy">Tell us what needs to go. We quote the actual job from photos instead of forcing your items into a confusing truck-load chart.</p>
      </div>
      <div class="service-cards">
        {topServices.map(([slug, service]) => (
          <a href={`/services/${slug}/`} class="service-card-v2" data-track="service_click" data-astro-prefetch>
            <span class="service-card-icon"><Icon name={iconForService(slug)} size={26} /></span>
            <strong class="service-card-name">{service.name}</strong>
            <span class="service-card-desc">{service.headline}</span>
            <span class="service-card-price">{startingPriceForService(slug)}</span>
          </a>
        ))}
      </div>
      <details class="services-more">
        <summary>See all {Object.keys(services).length} services</summary>
        <div class="services-more-grid">
          {restServices.map(([slug, service]) => (
            <a href={`/services/${slug}/`} class="services-more-link" data-track="service_click" data-astro-prefetch>
              <Icon name={iconForService(slug)} size={18} /> {service.name}
              <span class="services-more-price">Photo quote</span>
            </a>
          ))}
        </div>
      </details>
    </section>

    <PricingPreview />

    <section class="section booking" id="quote">
      <div class="booking-grid">
        <div class="booking-intro">
          <p class="section-kicker" id="pricing">Get your quote</p>
          <h2>Send it once. Know the total before pickup.</h2>
          <p>{PRICE_FLOOR_DETAIL} Fastest path: <a href={smsLink} data-track="sms_click">text photos to {phoneDisplay}</a>.</p>
          <TrustBar aggregate={agg} compact={true} verified={reviewsData.source === 'google'} />
        </div>
        <aside class="quote-card">
          <p class="quote-step2-banner">Add a few details and photos so we can price the real job.</p>
          <TelegramForm />
        </aside>
      </div>
    </section>

    <Testimonials count={9} />
    <BeforeAfter />

    <section class="section whytext" aria-label="Why customers choose Dakota Valley">
      <div class="section-head"><div>
        <p class="section-kicker">Compare the final experience</p>
        <h2>Do not let the lowest teaser price make the decision for you.</h2>
      </div></div>
      <div class="whytext-cols">
        <article class="whytext-card whytext-them">
          <h3>The low-ball approach</h3>
          <ul>
            <li><Icon name="lucide:tag" size={16} /> Advertise a number that covers very little</li>
            <li><Icon name="lucide:circle-help" size={16} /> Wait until arrival to settle the real price</li>
            <li><Icon name="lucide:phone-off" size={16} /> Put customers through a call center or sales pitch</li>
            <li><Icon name="lucide:trash-2" size={16} /> Treat donation and recycling as an afterthought</li>
          </ul>
        </article>
        <article class="whytext-card whytext-us">
          <h3>The Dakota Valley way</h3>
          <ul>
            <li><Icon name="lucide:camera" size={16} /> Text photos and skip the estimate visit</li>
            <li><Icon name="lucide:badge-check" size={16} /> Review the written quote before booking</li>
            <li><Icon name="lucide:calendar-check" size={16} /> Confirm an available pickup window with the crew that fits your day</li>
            <li><Icon name="lucide:recycle" size={16} /> Route usable and recyclable items responsibly</li>
          </ul>
          <a class="button primary" href={smsLink} data-track="sms_click"><Icon name="lucide:message-square-text" size={18} /> Text photos now</a>
        </article>
      </div>
    </section>

    <ImpactChart />
    <HeavyItems />

    <ServiceAreaFinder heading="Minnesota coverage with routes that make sense." />

    <section class="section process" id="how">
      <p class="section-kicker">How it works</p>
      <h2>Three steps from clutter to clear.</h2>
      <div class="steps">
        <article><span class="step-number">1</span><h3>Text photos</h3><p>Send clear photos of everything, plus your city and where the items are located.</p></article>
        <article><span class="step-number">2</span><h3>Review the quote</h3><p>Receive the exact total in writing and choose an available pickup window.</p></article>
        <article><span class="step-number">3</span><h3>We haul</h3><p>The crew arrives, loads the items, handles the routing, and leaves the area tidy.</p></article>
      </div>
    </section>

    <section class="section about" id="about">
      <div class="section-head"><div>
        <p class="section-kicker">About Dakota Valley</p>
        <h2>Twin Cities-grown since 2023.</h2>
      </div></div>
      <div class="about-grid">
        <div class="about-body">
          <p>Dakota Valley Junk Removal started in 2023 with one truck serving Minneapolis and St. Paul. The routes now reach across Minnesota, but the principles have stayed simple: honest communication, dependable service, and responsible disposal.</p>
          <p>Donation partners include <strong>Bridging</strong>, <strong>Arc's Value Village</strong>, and <strong>Savers</strong>. Loads are sorted for donation, recycling, and compost when practical instead of automatically heading to a landfill.</p>
          <p>The team lives in the same communities it serves—from Edina and Eagan to Minneapolis and St. Paul. Every job gets the same attention, whether it is one bulky item or a full property cleanout.</p>
        </div>
        <div class="about-stats">
          <div class="about-stat"><div class="about-stat-number">7 days</div><div class="about-stat-label">Open every week, 8 AM – 9 PM</div></div>
          <div class="about-stat"><div class="about-stat-number">Written</div><div class="about-stat-label">Quote reviewed before booking</div></div>
          <div class="about-stat"><div class="about-stat-number">Local</div><div class="about-stat-label">Owned and operated since 2023</div></div>
        </div>
      </div>
    </section>

    <section class="section city-locale" aria-label="Disposal guides">
      <div class="section-head"><div>
        <p class="section-kicker">Guides</p>
        <h2>Know before you throw.</h2>
      </div>
        <p class="section-copy">Learn where common items can go, how responsible disposal works, and how to prepare for a faster cleanout.</p>
      </div>
      <div class="city-grid">
        {Object.entries(guides).map(([slug, guide]) => (
          <a href={`/guides/${slug}/`} class="city-link" data-track="guide_click">{guide.shortTitle}</a>
        ))}
        <a href="/guides/" class="city-link">All guides</a>
      </div>
    </section>

    <section class="section" id="faq">
      <div class="section-head"><div>
        <p class="section-kicker">FAQ</p>
        <h2>Quick answers before you text.</h2>
      </div></div>
      <div class="faq-list">
        {faqs.map((faq, index) => (
          <details class="faq-card" open={index === 0}>
            <summary>{faq.q}</summary>
            <p>{faq.a}</p>
          </details>
        ))}
      </div>
    </section>

    <SiteFooter />

    <div class="mobile-cta" aria-label="Quick actions">
      <a class="button primary" href={smsLink} data-track="sms_click">Text</a>
      <a class="button secondary" href="/quote/">Get a Quote</a>
    </div>
  </main>

</Layout>
