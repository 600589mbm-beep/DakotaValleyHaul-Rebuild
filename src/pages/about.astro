---
import { Icon } from 'astro-icon/components';
import Layout from '../layouts/Layout.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { PRICE_FLOOR } from '../data/booking.js';
import { businessNode } from '../data/schemaBusiness.js';

const site = 'https://dakotavalleyjunkremovalservice.com';
const canonical = `${site}/about/`;
const phoneDisplay = '(952) 232-5107';
const smsLink = 'sms:+19522325107';

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    businessNode,
    {
      '@type': 'AboutPage',
      name: 'About Dakota Valley Junk Removal',
      url: canonical,
      mainEntity: { '@id': `${site}/#business` },
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Home', item: `${site}/` },
        { '@type': 'ListItem', position: 2, name: 'About Dakota Valley Junk Removal' },
      ],
    },
  ],
};
---
<Layout
  title="About Dakota Valley Junk Removal | Local Minnesota Hauling Since 2023"
  description="Meet Dakota Valley Junk Removal, a locally owned Minnesota junk-removal company built around written photo quotes, dependable pickup windows and responsible donation and recycling routes."
  canonical={canonical}
  schema={schema}
>
  <main>
    <section class="city-hero">
      <nav class="nav" aria-label="Primary navigation">
        <a class="brand" href="/"><span class="brand-mark"><Icon name="lucide:truck" size={22} /></span><span>Dakota Valley</span></a>
        <a class="nav-call" href={smsLink} data-track="sms_click"><Icon name="lucide:message-square-text" size={18} /> Text {phoneDisplay}</a>
      </nav>
      <div class="city-hero-content">
        <p class="breadcrumb"><a href="/">Home</a> <span aria-hidden="true"> / </span><span>About</span></p>
        <p class="section-kicker">Locally owned since 2023</p>
        <h1>Junk removal built around <span class="city-accent">clear communication.</span></h1>
        <p class="hero-copy">Dakota Valley serves Minnesota homes, businesses and property managers with one-time junk removal, bulky-item pickup and cleanouts. Customers send photos, review the written quote and choose a pickup window before the crew arrives.</p>
        <div class="hero-actions">
          <a class="button primary" href={smsLink} data-track="sms_click"><Icon name="lucide:camera" size={18} /> Text photos for a quote</a>
          <span class="price-floor"><Icon name="lucide:tag" size={14} />{PRICE_FLOOR}</span>
        </div>
      </div>
    </section>

    <section class="section">
      <div class="section-head"><div>
        <p class="section-kicker">Why Dakota Valley</p>
        <h2>A local alternative to call centers and arrival-day sales pitches.</h2>
      </div>
        <p class="section-copy">The goal is straightforward: make it easier to understand the job, approve the price and get unwanted items out without losing an entire day.</p>
      </div>
      <div class="city-service-grid">
        <article class="city-service-card"><span class="city-service-icon"><Icon name="lucide:camera" size={20} /></span><h3>Photo-based quoting</h3><p>Clear photos help identify volume, access, weight and special handling before service is scheduled.</p></article>
        <article class="city-service-card"><span class="city-service-icon"><Icon name="lucide:badge-check" size={20} /></span><h3>Written total</h3><p>The quoted amount is reviewed before booking so customers can compare the complete job—not only a teaser price.</p></article>
        <article class="city-service-card"><span class="city-service-icon"><Icon name="lucide:calendar-check" size={20} /></span><h3>Scheduled pickup</h3><p>Customers choose from available route windows after approving the quote.</p></article>
        <article class="city-service-card"><span class="city-service-icon"><Icon name="lucide:recycle" size={20} /></span><h3>Responsible routing</h3><p>Reusable and recyclable items are routed responsibly whenever condition and local acceptance rules allow.</p></article>
      </div>
    </section>

    <section class="section whytext" aria-label="What Dakota Valley does and does not provide">
      <div class="section-head"><div>
        <p class="section-kicker">The right service for the job</p>
        <h2>One-time removal—not weekly garbage collection.</h2>
      </div></div>
      <div class="whytext-cols">
        <article class="whytext-card whytext-us">
          <h3>What we handle</h3>
          <ul>
            <li><Icon name="lucide:check" size={16} /> Furniture, mattresses and household items</li>
            <li><Icon name="lucide:check" size={16} /> Appliances, electronics and scrap metal</li>
            <li><Icon name="lucide:check" size={16} /> Garages, estates, offices and property cleanouts</li>
            <li><Icon name="lucide:check" size={16} /> Yard debris and approved light-demolition material</li>
          </ul>
        </article>
        <article class="whytext-card whytext-them">
          <h3>What needs another provider</h3>
          <ul>
            <li><Icon name="lucide:alert-circle" size={16} /> Weekly residential trash and recycling carts</li>
            <li><Icon name="lucide:alert-circle" size={16} /> Wet chemicals, medication and loose sharps</li>
            <li><Icon name="lucide:alert-circle" size={16} /> Asbestos, biohazards and regulated hazardous waste</li>
            <li><Icon name="lucide:alert-circle" size={16} /> Materials a licensed specialty contractor must remove</li>
          </ul>
        </article>
      </div>
    </section>

    <section class="section city-cta">
      <div>
        <h2>Show us what needs to go.</h2>
        <p>Text clear photos, your city and where the items are located. You will receive the written quote before choosing a pickup window.</p>
      </div>
      <div class="hero-actions">
        <a class="button primary" href={smsLink} data-track="sms_click"><Icon name="lucide:message-square-text" size={18} /> Text {phoneDisplay}</a>
        <a class="button secondary" href="/#quote">Use the quote helper</a>
      </div>
    </section>

    <SiteFooter />
    <div class="mobile-cta">
      <a class="button primary" href={smsLink} data-track="sms_click">Text</a>
      <a class="button secondary" href="/#quote">Book</a>
    </div>
  </main>
</Layout>
