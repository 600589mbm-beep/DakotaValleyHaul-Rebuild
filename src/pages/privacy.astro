---
import Layout from '../layouts/Layout.astro';
import SiteFooter from '../components/SiteFooter.astro';

const site = 'https://dakotavalleyjunkremovalservice.com';
const updated = 'July 11, 2026';
---
<Layout
  title="Privacy Policy | Dakota Valley Junk Removal"
  description="How Dakota Valley Junk Removal uses quote form, contact, analytics, and advertising measurement data."
  canonical={`${site}/privacy/`}
>
  <main class="policy-page">
    <section class="policy-hero">
      <span class="dv-eyebrow"><span class="dv-dot"></span> Privacy</span>
      <h1>Privacy Policy</h1>
      <p>Last updated: {updated}</p>
    </section>

    <section class="policy-content" aria-label="Privacy policy details">
      <h2>Information you send us</h2>
      <p>
        When you request a quote, text us, email us, or submit the booking form, we may receive
        your name, phone number, pickup address, city or ZIP code, job details, photos, and any
        other information you choose to provide.
      </p>

      <h2>How we use it</h2>
      <p>
        We use this information to answer questions, prepare quotes, schedule junk removal,
        route crews, send confirmations, and follow up about your request.
      </p>

      <h2>Website analytics and ads</h2>
      <p>
        We use website analytics and advertising tools, including Meta Pixel, to understand how
        visitors use the site, measure ad performance, and improve future ads. These tools may
        use cookies or similar technologies to collect page views, contact clicks, quote form
        starts, and quote form submissions.
      </p>

      <h2>Sharing</h2>
      <p>
        We do not sell your quote request information. We may share information with service
        providers that help operate the website, deliver form submissions, send messages, host
        the site, or measure advertising performance.
      </p>

      <h2>Your choices</h2>
      <p>
        You can block or delete cookies in your browser settings. You can also use Meta's ad
        preferences and privacy settings to manage how Meta uses information for ads.
      </p>

      <h2>Contact</h2>
      <p>
        For privacy questions, email <a href="mailto:info@dakotavalleyjunkremovalservice.com">info@dakotavalleyjunkremovalservice.com</a>
        or text <a href="sms:+19522325107">(952) 232-5107</a>.
      </p>
    </section>
  </main>
  <SiteFooter />
</Layout>
