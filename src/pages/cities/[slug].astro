---
import SiteNav from '../../components/SiteNav.astro';
import { PICKUP_REQUIREMENTS, QUOTE_POLICY, SCHEDULING_POLICY, SPECIALTY_POLICY } from '../../data/servicePolicy.js';
import { Icon } from 'astro-icon/components';
import { PRICE_FLOOR, CITY_TESTIMONIALS_ENABLED } from '../../data/booking.js';
import Layout from '../../layouts/Layout.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import { cities, getCitySlugs } from '../../data/cities.js';
import { businessNode, BUSINESS_ID } from '../../data/schemaBusiness.js';
import { services } from '../../data/services.js';
import { pickPhotos, buildAlt } from '../../data/photos.js';
import { iconForService } from '../../data/serviceIcons.js';
import { cityFaqs, faqSchema } from '../../data/comboContent.js';

export function getStaticPaths() {
  return getCitySlugs().map((slug) => ({
    params: { slug },
    props: { city: cities[slug], slug },
  }));
}

const { city, slug } = Astro.props;
const cityPhotos = pickPhotos(slug, 3);
const heroPhoto = cityPhotos[0];
const galleryPhotos = cityPhotos.slice(1);
const hasIllustrations = cityPhotos.some((photo) => photo.illustration);
const phoneDisplay = '(952) 232-5107';
const smsLink = 'sms:+19522325107';
const email = 'info@dakotavalleyjunkremovalservice.com';
const canonical = `https://dakotavalleyjunkremovalservice.com/cities/${slug}/`;
const quoteForm = `/quote/?city=${encodeURIComponent(city.name)}`;
const citySms = `${smsLink}?&body=${encodeURIComponent(`Junk removal quote for ${city.name}, MN.\nPlease send photos and item details.`)}`;
const faqs = cityFaqs(city, slug);

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    businessNode,
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://dakotavalleyjunkremovalservice.com/' },
        { '@type': 'ListItem', position: 2, name: 'Service areas', item: 'https://dakotavalleyjunkremovalservice.com/service-areas/' },
        { '@type': 'ListItem', position: 3, name: `${city.name}, MN` },
      ],
    },
    {
      '@type': 'Service',
      name: `Junk Removal in ${city.name}, MN`,
      provider: { '@id': BUSINESS_ID },
      areaServed: {
        '@type': 'City',
        name: city.name,
        containedInPlace: { '@type': 'AdministrativeArea', name: city.county },
      },
      description: city.intro,
      serviceType: 'Curbside and garage junk pickup',
    },
    faqSchema(faqs),
  ],
};
---
<Layout
  title={city.metaTitle}
  description={city.metaDescription}
  canonical={canonical}
  schema={schema}
>
  <main>
    <section class="city-hero">
      <SiteNav />

      <div class="city-hero-content">
        <p class="breadcrumb">
          <a href="/">Home</a>
          <span aria-hidden="true"> / </span>
          <a href="/service-areas/">Service areas</a>
          <span aria-hidden="true"> / </span>
          <span>{city.name}</span>
        </p>
        <h1>Junk Removal in <span class="city-accent">{city.name}, MN</span></h1>
        <p class="hero-copy">{city.intro}</p>
        <p class="hero-copy" data-service-scope>Curbside, driveway and accessible-garage pickup only. No inside-home pickup.</p>
        <p class="hero-copy">Paid pickup at your address. Send item photos for a written quote, approve the total, then confirm an available pickup window with the crew.</p>
        <div class="hero-actions">
          <a class="button primary" href={citySms}><Icon name="lucide:message-square-text" size={18} /> Text photos to start</a>
          <span class="price-floor"><Icon name="lucide:tag" size={14} />{PRICE_FLOOR}</span>
          <a class="button secondary" href={quoteForm}><Icon name="lucide:camera" size={18} /> Get a Quote</a>
        </div>
        <p class="hero-meta">
          <Icon name="lucide:map-pin" size={15} /> {city.county} &middot; Loads from $85 &middot; Curbside and garage pickup
        </p>
      </div>
    </section>

    <figure class="city-hero-image">
      <img
        src={heroPhoto.src}
        width={heroPhoto.width}
        height={heroPhoto.height}
        alt={buildAlt(heroPhoto.desc, city.name)}
        loading="eager"
        fetchpriority="high"
      />
      <figcaption>{buildAlt(heroPhoto.desc, city.name)}</figcaption>
    </figure>

    <section class="section city-services">
      <div class="section-head">
        <div>
          <p class="section-kicker">What we haul in {city.name}</p>
          <h2>What junk removal services do we offer in {city.name}?</h2>
        </div>
      </div>
      <p class="section-copy" style="margin-bottom: 24px">
        Request paid pickup of furniture, mattresses, appliances, garage clutter and yard debris in {city.name}, MN. For garage and estate cleanouts, items must be sorted and safely staged before arrival. Send photos to confirm the accepted items, access and disposal needs; the crew loads only the approved staged items.
      </p>
      <div class="city-service-grid">
        {Object.entries(services).slice(0, 6).map(([sl, s]) => (
          <a href={`/cities/${slug}/${sl}/`} class="city-service-card">
            <span class="city-service-icon"><Icon name={iconForService(sl)} size={22} /></span>
            <h3>{s.name}</h3>
            <p>{s.headline}</p>
          </a>
        ))}
      </div>
    </section>

    <section class="section city-locale">
      <div class="section-head">
        <div>
          <p class="section-kicker">{city.name} neighborhoods</p>
          <h2>Which {city.name} neighborhoods does Dakota Valley serve?</h2>
        </div>
      </div>
      <p class="section-copy" style="margin-bottom: 24px">
        Send your {city.name} address and photos to confirm service availability. Pickup is by appointment after you approve the written quote and the crew confirms an available window. Timing depends on your address, job size and route capacity. Same-day pickup may be available, but is not guaranteed.
      </p>
      <div class="city-locale-grid">
        <div>
          <h3 class="city-list-title">Neighborhoods served</h3>
          <ul class="city-list">
            {city.neighborhoods.map((n) => <li><Icon name="lucide:check" size={14} /> {n}</li>)}
          </ul>
        </div>
        <div>
          <h3 class="city-list-title">Nearby landmarks</h3>
          <ul class="city-list">
            {city.landmarks.map((l) => <li><Icon name="lucide:map-pin" size={14} /> {l}</li>)}
          </ul>
        </div>
      </div>
    </section>

    {CITY_TESTIMONIALS_ENABLED && city.testimonial && (
      <section class="section city-testimonial">
        <blockquote>
          <p>&ldquo;{city.testimonial.text}&rdquo;</p>
          <footer>
            <strong>{city.testimonial.name}</strong>
            <span>{city.testimonial.location}</span>
          </footer>
        </blockquote>
      </section>
    )}

    <section class="section city-gallery">
      <div class="section-head">
        <div>
          <p class="section-kicker">{hasIllustrations ? 'Pickup illustrations' : 'Pickup photos'}</p>
          <h2>{hasIllustrations ? 'Examples of items staged for pickup.' : 'Items ready for pickup.'}</h2>
        </div>
      </div>
      {hasIllustrations && <p class="section-copy" data-illustration-disclosure>These illustrations show pickup examples. They are not photographs of completed jobs in {city.name}.</p>}
      <div class="city-gallery-grid">
        {galleryPhotos.map((p) => (
          <figure>
            <img
              src={p.src}
              width={p.width}
              height={p.height}
              alt={buildAlt(p.desc, city.name)}
              loading="lazy"
            />
            <figcaption>{p.illustration ? 'Illustration: ' : ''}{p.desc}</figcaption>
          </figure>
        ))}
      </div>
    </section>

    <section class="section city-locale">
      <div class="section-head">
        <div>
          <p class="section-kicker">Services in {city.name}</p>
          <h2>Which junk removal services are most popular in {city.name}?</h2>
        </div>
      </div>
      <p class="section-copy" style="margin-bottom: 24px">
        Explore accepted items, staging requirements and photo-quote details for each service in {city.name}. Outdoor specialty projects and rental requests require separate review and written approval.
      </p>
      <div class="city-grid">
        {Object.entries(services).map(([serviceSlug, s]) => (
          <a href={`/cities/${slug}/${serviceSlug}/`} class="city-link">
            {s.name} in {city.name}
          </a>
        ))}
      </div>
    </section>

    <section class="section">
      <div class="section-head">
        <div>
          <p class="section-kicker">{city.name} pricing</p>
          <h2>How does junk removal pricing work in {city.name}?</h2>
        </div>
      </div>
      <p class="section-copy">
        Eligible curbside, driveway or accessible-garage pickups have an $85 minimum. This is not a flat price for every item. Send photos for the exact total in writing before confirming pickup. {QUOTE_POLICY} <a href="/pricing/">How photo quotes work</a>.
      </p>
      <p class="section-copy">{SPECIALTY_POLICY}</p>
      <p class="section-copy"><a href={`/quote/${slug}/`} data-city-quote-guide>How to prepare your {city.name} quote request</a>: photos to send, local pickup details and answers before you request a price.</p>
    </section>

    <section class="section">
      <div class="section-head">
        <div>
          <p class="section-kicker">{city.name} scheduling</p>
          <h2>How quickly can Dakota Valley pick up in {city.name}?</h2>
        </div>
      </div>
      <p class="section-copy">
        {SCHEDULING_POLICY}
      </p>
      <p class="section-copy">{PICKUP_REQUIREMENTS}</p>
    </section>

    <section class="section">
      <div class="section-head">
        <div>
          <p class="section-kicker">{city.name} FAQ</p>
          <h2>Common questions from {city.name} customers.</h2>
        </div>
      </div>
      <div class="faq-list">
        {faqs.map(({ q, a }, index) => (
          <details class="faq-card" open={index === 0}>
            <summary>{q}</summary>
            <p>{a}</p>
          </details>
        ))}
      </div>
    </section>

    <section class="section city-cta">
      <div>
        <h2>Ready for pickup in {city.name}?</h2>
        <p>Send photos and item details for a written quote. Approve the total before confirming an available pickup window. A quote request does not reserve an appointment.</p>
      </div>
      <div class="hero-actions">
        <a class="button primary" href={citySms}><Icon name="lucide:message-square-text" size={16} /> Text {phoneDisplay}</a>
          <span class="price-floor"><Icon name="lucide:tag" size={14} />{PRICE_FLOOR}</span>
        <a class="button secondary" href={quoteForm}>Get a Quote</a>
      </div>
    </section>

    <SiteFooter />

    <div class="mobile-cta" aria-label="Mobile contact actions">
      <a class="button primary" href={citySms}>Text</a>
      <a class="button secondary" href={quoteForm}>Get a Quote</a>
    </div>
  </main>
</Layout>
