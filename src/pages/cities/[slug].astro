---
import { Icon } from 'astro-icon/components';
import { PRICE_FLOOR, CITY_TESTIMONIALS_ENABLED } from '../../data/booking.js';
import Layout from '../../layouts/Layout.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import { cities, getCitySlugs } from '../../data/cities.js';
import { BUSINESS_ID, SAME_AS } from '../../data/schemaBusiness.js';
import { services } from '../../data/services.js';
import { pickPhotos, pickRealJobPhotos, pickFleetPhotos, buildAlt } from '../../data/photos.js';
import { iconForService } from '../../data/serviceIcons.js';
import { cityFaqs, faqSchema } from '../../data/comboContent.js';

export function getStaticPaths() {
  return getCitySlugs().map((slug) => ({
    params: { slug },
    props: { city: cities[slug], slug },
  }));
}

const { city, slug } = Astro.props;
const isAppleValley = slug === 'apple-valley';
const fleetPhotos = pickFleetPhotos(slug, isAppleValley ? 2 : 1);
const realProofPhotos = pickRealJobPhotos(slug, isAppleValley ? 20 : 4).filter((photo) => photo.category !== 'fleet');
const fallbackPhotos = isAppleValley ? fleetPhotos : pickPhotos(slug, 3);
const heroPhoto = fleetPhotos[0] ?? realProofPhotos[0] ?? fallbackPhotos[0];
const galleryPhotos = realProofPhotos.length
  ? [...fleetPhotos.slice(1), ...realProofPhotos]
  : fallbackPhotos.slice(heroPhoto === fallbackPhotos[0] ? 1 : 0);
const cityPhotos = heroPhoto ? [heroPhoto, ...galleryPhotos] : [];
const hasRealProofPhotos = cityPhotos.some((p) => p.real);
const phoneDisplay = '(952) 232-5107';
const smsLink = 'sms:+19522325107';
const email = 'info@dakotavalleyjunkremovalservice.com';
const canonical = `https://dakotavalleyjunkremovalservice.com/cities/${slug}/`;
const citySms = `${smsLink}?&body=${encodeURIComponent(`Junk removal quote for ${city.name}, MN.\nPlease send photos and item details.`)}`;
const faqs = cityFaqs(city, slug);
const heroTitle = isAppleValley
  ? 'Apple Valley Junk Removal From $85. Text Photos, Get a Firm Quote.'
  : `Junk Removal in ${city.name}, MN`;
const heroIntro = isAppleValley
  ? 'Skip the call center and the driveway estimate. Text photos of the pile, garage, sofa, or appliance and Dakota Valley sends the price in writing before you book.'
  : city.intro;
const routeMeta = isAppleValley
  ? 'Dakota County route coverage: Downtown Apple Valley, Cobblestone Lake, Palomino Hills, Greenleaf, Galaxie, Southcross, Pennock, and the Minnesota Zoo area.'
  : `${city.county} - Loads from $85 - Curbside and garage pickup`;
const pageTitle = isAppleValley ? city.metaTitle : `${city.name} Junk Removal | From $85 | Dakota Valley`;
const pageDescription = isAppleValley
  ? city.metaDescription
  : `${city.name} junk removal from $85. Text photos for a firm written quote. Curbside and garage pickup across ${city.county}.`;

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://dakotavalleyjunkremovalservice.com/' },
        { '@type': 'ListItem', position: 2, name: 'Service areas', item: 'https://dakotavalleyjunkremovalservice.com/#areas' },
        { '@type': 'ListItem', position: 3, name: `${city.name}, MN` },
      ],
    },
    {
      '@type': 'Service',
      name: `Junk Removal in ${city.name}, MN`,
      provider: { '@id': 'https://dakotavalleyjunkremovalservice.com/#business' },
      areaServed: {
        '@type': 'City',
        name: city.name,
        containedIn: { '@type': 'AdministrativeArea', name: city.county },
      },
      description: city.intro,
      serviceType: 'Curbside and garage junk pickup',
      ...(city.geo && {
        provider: {
          '@id': 'https://dakotavalleyjunkremovalservice.com/#business',
        },
      }),
    },
    {
      '@type': 'LocalBusiness',
      '@id': BUSINESS_ID,   // resolves the Service.provider reference on-page
      name: `Dakota Valley Junk Removal — ${city.name}`,
      url: canonical,
      sameAs: SAME_AS,
      telephone: '+1-952-232-5107',
      email: 'info@dakotavalleyjunkremovalservice.com',
      priceRange: '$30 – $750',
      address: {
        '@type': 'PostalAddress',
        streetAddress: '1964 Rahncliff Ct, Ste 200, #22342',
        addressLocality: 'Eagan',
        addressRegion: 'MN',
        postalCode: '55122',
        addressCountry: 'US',
      },
      ...(city.geo && {
        geo: { '@type': 'GeoCoordinates', latitude: city.geo.latitude, longitude: city.geo.longitude },
      }),
      areaServed: { '@type': 'City', name: city.name, containedIn: { '@type': 'AdministrativeArea', name: city.county } },
      serviceType: ['Curbside junk pickup', 'Garage junk pickup', 'Furniture removal', 'Appliance recycling'],
      openingHoursSpecification: {
        '@type': 'OpeningHoursSpecification',
        dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday', 'Sunday'],
        opens: '08:00',
        closes: '21:00',
      },
      // No aggregateRating: we do not assert review ratings until they come from a
      // verified source (Google). Fabricated rating schema is review spam.
    },
    faqSchema(faqs),
  ],
};
---
<Layout
  title={pageTitle}
  description={pageDescription}
  canonical={canonical}
  schema={schema}
>
  <main>
    <section class="city-hero">
      <nav class="nav" aria-label="Primary navigation">
        <a class="brand" href="/" aria-label="Dakota Valley home">
          <span class="brand-mark"><Icon name="lucide:truck" size={22} /></span>
          <span>Dakota Valley</span>
        </a>
        <a class="nav-call" href={smsLink}><Icon name="lucide:message-square-text" size={16} /> Text {phoneDisplay}</a>
      </nav>

      <div class="city-hero-content">
        <p class="breadcrumb">
          <a href="/">Home</a>
          <span aria-hidden="true"> / </span>
          <a href="/#areas">Service areas</a>
          <span aria-hidden="true"> / </span>
          <span>{city.name}</span>
        </p>
        <h1>{heroTitle}</h1>
        <p class="hero-copy">{heroIntro}</p>
        <div class="hero-actions">
          <a class="button primary" href={citySms}><Icon name="lucide:message-square-text" size={18} /> Text photos to start</a>
          <span class="price-floor"><Icon name="lucide:tag" size={14} />{PRICE_FLOOR}</span>
          <a class="button secondary" href="/#quote"><Icon name="lucide:camera" size={18} /> Use the quote helper</a>
        </div>
        {isAppleValley && (
          <div class="city-proof-strip" aria-label="Apple Valley quote proof points">
            <span><Icon name="lucide:tag" size={16} /> From $85</span>
            <span><Icon name="lucide:message-square-text" size={16} /> Quote by text</span>
            <span><Icon name="lucide:shield-check" size={16} /> Licensed and insured</span>
            <span><Icon name="lucide:route" size={16} /> Dakota County routes</span>
          </div>
        )}
        <p class="hero-meta">
          <Icon name="lucide:map-pin" size={15} /> {routeMeta}
        </p>
            {isAppleValley && (
              <aside class="city-comparison-card" aria-label="Why Dakota Valley is different">
                <strong>No call center. No on-site surprise quote. Text photos, get the price in writing.</strong>
                <span>Then choose a pickup window that fits the Dakota County route.</span>
              </aside>
            )}
      </div>
    </section>

    {heroPhoto && (
      <figure class="city-hero-image">
        <img
          src={heroPhoto.src}
          width={heroPhoto.width}
          height={heroPhoto.height}
          alt={buildAlt(heroPhoto.desc, city.name)}
          loading="eager"
          fetchpriority="high"
        />
        <figcaption>{buildAlt(heroPhoto.desc, city.name)}</figcaption>
      </figure>
    )}

    <section class="section city-services">
      <div class="section-head">
        <div>
          <p class="section-kicker">What we haul in {city.name}</p>
          <h2>What junk removal services do we offer in {city.name}?</h2>
        </div>
      </div>
      <p class="section-copy" style="margin-bottom: 24px">
        Dakota Valley provides comprehensive junk hauling in {city.name}, MN — including furniture removal, appliance recycling, full garage cleanouts, yard waste, mattress disposal, and estate cleanouts. Crews handle the loading; you stage items at the curb or in the garage.
      </p>
      <div class="city-service-grid">
        {Object.entries(services).slice(0, 6).map(([sl, s]) => (
          <a href={`/cities/${slug}/${sl}/`} class="city-service-card">
            <span class="city-service-icon"><Icon name={iconForService(sl)} size={22} /></span>
            <h3>{s.name}</h3>
            <p>{s.headline}</p>
          </a>
        ))}
      </div>
    </section>

    <section class="section city-locale">
      <div class="section-head">
        <div>
          <p class="section-kicker">{city.name} neighborhoods</p>
          <h2>Which {city.name} neighborhoods does Dakota Valley serve?</h2>
        </div>
      </div>
      <p class="section-copy" style="margin-bottom: 24px">
        Routes cover every {city.name} neighborhood and the surrounding {city.county} grid. Same-day pickups are scheduled based on crew capacity along the route — text photos and a location to confirm a window.
      </p>
      <div class="city-locale-grid">
        <div>
          <h3 class="city-list-title">Neighborhoods served</h3>
          <ul class="city-list">
            {city.neighborhoods.map((n) => <li><Icon name="lucide:check" size={14} /> {n}</li>)}
          </ul>
        </div>
        <div>
          <h3 class="city-list-title">Nearby landmarks</h3>
          <ul class="city-list">
            {city.landmarks.map((l) => <li><Icon name="lucide:map-pin" size={14} /> {l}</li>)}
          </ul>
        </div>
      </div>
    </section>

    {CITY_TESTIMONIALS_ENABLED && city.testimonial && (
      <section class="section city-testimonial">
        <blockquote>
          <p>&ldquo;{city.testimonial.text}&rdquo;</p>
          <footer>
            <strong>{city.testimonial.name}</strong>
            <span>{city.testimonial.location}</span>
          </footer>
        </blockquote>
      </section>
    )}

    {galleryPhotos.length > 0 && (
      <section class="section city-gallery">
        <div class="section-head">
          <div>
            <p class="section-kicker">{city.name} job photos</p>
            <h2>{hasRealProofPhotos ? 'Real loads, real curbs.' : 'Route-ready pickup examples.'}</h2>
          </div>
        </div>
        <div class="city-gallery-grid">
          {galleryPhotos.map((p) => (
            <figure>
              <img
                src={p.src}
                width={p.width}
                height={p.height}
                alt={buildAlt(p.desc, city.name)}
                loading="lazy"
              />
            </figure>
          ))}
        </div>
      </section>
    )}

    <section class="section city-locale">
      <div class="section-head">
        <div>
          <p class="section-kicker">Services in {city.name}</p>
          <h2>Which junk removal services are most popular in {city.name}?</h2>
        </div>
      </div>
      <p class="section-copy" style="margin-bottom: 24px">
        Most {city.name} jobs are garage cleanouts, furniture removal, and appliance recycling. Each service has its own landing page with pricing examples, accepted items, and the request flow.
      </p>
      <div class="city-grid">
        {Object.entries(services).map(([serviceSlug, s]) => (
          <a href={`/cities/${slug}/${serviceSlug}/`} class="city-link">
            {s.name} in {city.name}
          </a>
        ))}
      </div>
    </section>

    <section class="section">
      <div class="section-head">
        <div>
          <p class="section-kicker">{city.name} pricing</p>
          <h2>How does junk removal pricing work in {city.name}?</h2>
        </div>
      </div>
      <p class="section-copy">
        Pricing in {city.name} is two-part: junk and cleanout loads are volume-based from $85 — single item from $85, pickup-bed load $85–$170, van load $255–$550, and a full box-truck load up to $750. Common recyclables are flat per-piece rates with no load minimum — mattresses from $100, refrigerators from $100, TVs from $50, tires $30 each. Everything is quoted from photos before pickup. <a href="/pricing/">See the full pricing breakdown</a>.
      </p>
    </section>

    <section class="section">
      <div class="section-head">
        <div>
          <p class="section-kicker">{city.name} scheduling</p>
          <h2>How quickly can Dakota Valley pick up in {city.name}?</h2>
        </div>
      </div>
      <p class="section-copy">
        Most {city.name} appointments are scheduled within 2–3 business days. Same-day pickups are available based on crew capacity along the route — text photos and your zip to check current availability. The crew calls 30 minutes before arrival and sends a completion photo when the job is done.
      </p>
    </section>

    <section class="section">
      <div class="section-head">
        <div>
          <p class="section-kicker">{city.name} FAQ</p>
          <h2>Common questions from {city.name} customers.</h2>
        </div>
      </div>
      <div class="faq-list">
        {faqs.map(({ q, a }, index) => (
          <details class="faq-card" open={index === 0}>
            <summary>{q}</summary>
            <p>{a}</p>
          </details>
        ))}
      </div>
    </section>

    <section class="section city-cta">
      <div>
        <h2>Ready for pickup in {city.name}?</h2>
        <p>Text photos, item details, and a preferred calendar window. The crew confirms and handles the rest.</p>
      </div>
      <div class="hero-actions">
        <a class="button primary" href={citySms}><Icon name="lucide:message-square-text" size={16} /> Text {phoneDisplay}</a>
          <span class="price-floor"><Icon name="lucide:tag" size={14} />{PRICE_FLOOR}</span>
        <a class="button secondary" href="/#quote">Use the quote helper</a>
      </div>
    </section>

    <SiteFooter />

    <div class="mobile-cta" aria-label="Mobile contact actions">
      <a class="button primary" href={citySms}>Text</a>
      <a class="button secondary" href="/#quote">Book</a>
    </div>
  </main>
</Layout>
