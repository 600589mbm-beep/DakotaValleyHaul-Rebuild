---
import SiteNav from '../../../components/SiteNav.astro';
import { SPECIALTY_POLICY, PICKUP_REQUIREMENTS } from '../../../data/servicePolicy.js';
import { Icon } from 'astro-icon/components';
import { PRICE_FLOOR, CITY_TESTIMONIALS_ENABLED } from '../../../data/booking.js';
import Layout from '../../../layouts/Layout.astro';
import SiteFooter from '../../../components/SiteFooter.astro';
import { cities, getCitySlugs } from '../../../data/cities.js';
import { services, getServiceSlugs, isSpecialtyService } from '../../../data/services.js';
import { businessNode } from '../../../data/schemaBusiness.js';
import { pickPhotos, buildAlt } from '../../../data/photos.js';
import {
  comboIntro,
  comboLocalNotes,
  comboFaqs,
  comboMeta,
  faqSchema,
  nearestCities,
} from '../../../data/comboContent.js';

export function getStaticPaths() {
  const paths = [];
  for (const citySlug of getCitySlugs()) {
    for (const serviceSlug of getServiceSlugs()) {
      paths.push({
        params: { citySlug, serviceSlug },
        props: { city: cities[citySlug], service: services[serviceSlug], citySlug, serviceSlug },
      });
    }
  }
  return paths;
}

const { city, service, citySlug, serviceSlug } = Astro.props;
const phoneDisplay = '(952) 232-5107';
const smsLink = 'sms:+19522325107';
const canonical = `https://dakotavalleyjunkremovalservice.com/cities/${citySlug}/${serviceSlug}/`;
const isJunkRemoval = serviceSlug === 'junk-pickup';
const isSpecialty = isSpecialtyService(serviceSlug);
const displayServiceName = isJunkRemoval ? 'Junk removal' : service.name;
const baseMeta = comboMeta(city, service, citySlug, serviceSlug);
const { title, description } = baseMeta;
const intro = isJunkRemoval
  ? `Need paid junk removal in ${city.name}? Dakota Valley picks up approved furniture, mattresses, appliances and clutter staged at the curb, in the driveway or in an accessible garage. Send clear photos and your ${city.county} pickup address, approve the written total, then confirm an available pickup window.`
  : comboIntro(city, service, citySlug, serviceSlug);
const localNotes = comboLocalNotes(city, service, citySlug, serviceSlug);
const faqs = comboFaqs(city, service, citySlug, serviceSlug);
const ctaSms = `${smsLink}?&body=${encodeURIComponent(`${displayServiceName} request for ${city.name}, MN.\nPlease send photos and item details.`)}`;
const quoteForm = `/quote/?city=${encodeURIComponent(city.name)}`;

const otherServices = Object.entries(services).filter(([slug]) => slug !== serviceSlug);
const otherCities = nearestCities(citySlug, 12).map((slug) => [slug, cities[slug]]);
const heroPhoto = pickPhotos(serviceSlug, 1)[0];
const serviceLabel = (slug, item) => slug === 'junk-pickup' ? 'Junk removal' : item.name;

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    businessNode,
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://dakotavalleyjunkremovalservice.com/' },
        { '@type': 'ListItem', position: 2, name: `${city.name}, MN`, item: `https://dakotavalleyjunkremovalservice.com/cities/${citySlug}/` },
        { '@type': 'ListItem', position: 3, name: displayServiceName },
      ],
    },
    {
      '@type': 'Service',
      name: `${displayServiceName} in ${city.name}, MN`,
      provider: { '@id': 'https://dakotavalleyjunkremovalservice.com/#business' },
      areaServed: {
        '@type': 'City',
        name: city.name,
        containedInPlace: { '@type': 'AdministrativeArea', name: city.county },
      },
      description,
      serviceType: displayServiceName,
      hasOfferCatalog: {
        '@type': 'OfferCatalog',
        name: `${displayServiceName} options in ${city.name}`,
        itemListElement: service.services.map((includedService) => ({
          '@type': 'Offer',
          itemOffered: { '@type': 'Service', name: includedService },
        })),
      },
    },
    faqSchema(faqs),
  ],
};
---
<Layout title={title} description={description} canonical={canonical} schema={schema}>
  <main>
    <section class="city-hero">
      <SiteNav />

      <div class="city-hero-content">
        <p class="breadcrumb">
          <a href="/">Home</a>
          <span aria-hidden="true"> / </span>
          <a href={`/cities/${citySlug}/`}>{city.name}, MN</a>
          <span aria-hidden="true"> / </span>
          <span>{displayServiceName}</span>
        </p>
        <h1>
          <span class="city-accent">{displayServiceName}</span> in {city.name}, MN
        </h1>
        <p class="hero-copy">{intro}</p>
        <p class="hero-copy" data-service-scope>Standard junk pickup: curbside, driveway and accessible-garage pickup only. No inside-home pickup.</p>
        {isSpecialty && <p class="hero-copy" data-specialty-scope>{SPECIALTY_POLICY}</p>}
        <p class="hero-copy">Send photos for a written quote. Approve the total before confirming an available pickup window. A quote request does not reserve an appointment.</p>
        <div class="hero-actions">
          <a class="button primary" href={ctaSms} data-track="sms_click"><Icon name="lucide:message-square-text" size={18} /> Text photos to start</a>
          <span class="price-floor"><Icon name="lucide:tag" size={14} />{isSpecialty ? 'Written project quote' : PRICE_FLOOR}</span>
          <a class="button secondary" href={quoteForm}><Icon name="lucide:camera" size={18} /> Get a Quote</a>
        </div>
        <p class="hero-meta">
          <Icon name="lucide:map-pin" size={15} /> {city.county} &middot; {isSpecialty ? 'Subject to project approval' : 'Paid staged pickup'} &middot; Written photo quote
        </p>
      </div>
    </section>

    <figure class="city-hero-image">
      <img
        src={heroPhoto.src}
        width={heroPhoto.width}
        height={heroPhoto.height}
        alt={buildAlt(heroPhoto.desc, city.name, displayServiceName)}
        loading="eager"
        fetchpriority="high"
      />
      <figcaption>{buildAlt(heroPhoto.desc, city.name, displayServiceName)}</figcaption>
    </figure>

    <section class="section city-services">
      <div class="section-head">
        <div>
          <p class="section-kicker">{displayServiceName} in {city.name}</p>
          <h2>What we include</h2>
        </div>
      </div>
      <div class="city-service-grid">
        {service.services.map((includedService) => (
          <article class="city-service-card">
            <span class="city-service-icon"><Icon name="lucide:check-circle-2" size={20} /></span>
            <h3>{includedService}</h3>
          </article>
        ))}
      </div>
      <p class="section-copy">{isSpecialty ? SPECIALTY_POLICY : PICKUP_REQUIREMENTS}</p>
    </section>

    <section class="section">
      <div class="section-head">
        <div>
          <p class="section-kicker">{city.name} pickup process</p>
          <h2>Four steps, mostly text.</h2>
        </div>
      </div>
      <div class="city-service-grid">
        {service.process.map((step, index) => (
          <article class="city-service-card">
            <span class="city-service-icon">{index + 1}</span>
            <h3>Step {index + 1}</h3>
            <p>{step}</p>
          </article>
        ))}
      </div>
    </section>

    <section class="section city-locale">
      <div class="section-head">
        <div>
          <p class="section-kicker">{city.name} coverage</p>
          <h2>Confirm pickup availability at your address.</h2>
        </div>
      </div>
      <p class="section-copy" style="margin-bottom: 24px">{localNotes}</p>
      <div class="city-locale-grid">
        <div>
          <h3 class="city-list-title">{city.name} neighborhoods we serve</h3>
          <ul class="city-list">
            {city.neighborhoods.map((neighborhood) => <li><Icon name="lucide:check" size={14} /> {neighborhood}</li>)}
          </ul>
        </div>
        <div>
          <h3 class="city-list-title">Nearby landmarks</h3>
          <ul class="city-list">
            {city.landmarks.map((landmark) => <li><Icon name="lucide:map-pin" size={14} /> {landmark}</li>)}
          </ul>
        </div>
      </div>
    </section>

    {CITY_TESTIMONIALS_ENABLED && city.testimonial && (
      <section class="section city-testimonial">
        <blockquote>
          <p>&ldquo;{city.testimonial.text}&rdquo;</p>
          <footer>
            <strong>{city.testimonial.name}</strong>
            <span>{city.testimonial.location}</span>
          </footer>
        </blockquote>
      </section>
    )}

    <section class="section">
      <div class="section-head">
        <div>
          <p class="section-kicker">{displayServiceName} FAQ</p>
          <h2>{city.name} questions, answered.</h2>
        </div>
      </div>
      <div class="faq-list">
        {faqs.map(({ q, a }, index) => (
          <details class="faq-card" open={index === 0}>
            <summary>{q}</summary>
            <p>{a}</p>
          </details>
        ))}
      </div>
    </section>

    <section class="section city-locale">
      <div class="section-head">
        <div>
          <p class="section-kicker">Other services in {city.name}</p>
          <h2>What else we haul.</h2>
        </div>
      </div>
      <div class="city-grid">
        {otherServices.map(([slug, otherService]) => (
          <a href={`/cities/${citySlug}/${slug}/`} class="city-link">{serviceLabel(slug, otherService)}</a>
        ))}
        <a href={`/cities/${citySlug}/`} class="city-link">All services in {city.name}</a>
      </div>
    </section>

    <section class="section city-locale">
      <div class="section-head">
        <div>
          <p class="section-kicker">{displayServiceName} in other cities</p>
          <h2>We also serve…</h2>
        </div>
      </div>
      <div class="city-grid">
        {otherCities.map(([slug, otherCity]) => (
          <a href={`/cities/${slug}/${serviceSlug}/`} class="city-link">{otherCity.name}</a>
        ))}
        <a href={`/services/${serviceSlug}/`} class="city-link">See all cities</a>
      </div>
    </section>

    <section class="section city-cta">
      <div>
        <h2>Need {displayServiceName.toLowerCase()} in {city.name}?</h2>
        <p>Send photos and item details for a written quote. Approve the total before confirming an available pickup window.</p>
        <p><a href={`/quote/${citySlug}/`}>Prepare your {city.name} quote request</a>.</p>
      </div>
      <div class="hero-actions">
        <a class="button primary" href={ctaSms} data-track="sms_click"><Icon name="lucide:message-square-text" size={18} /> Text {phoneDisplay}</a>
        <span class="price-floor"><Icon name="lucide:tag" size={14} />{isSpecialty ? 'Written project quote' : PRICE_FLOOR}</span>
        <a class="button secondary" href={quoteForm}>Get a Quote</a>
      </div>
    </section>

    <SiteFooter />

    <div class="mobile-cta" aria-label="Mobile contact actions">
      <a class="button primary" href={ctaSms} data-track="sms_click">Text</a>
      <a class="button secondary" href={quoteForm}>Get a Quote</a>
    </div>
  </main>
</Layout>
