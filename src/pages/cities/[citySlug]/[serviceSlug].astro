---
import { Icon } from 'astro-icon/components';
import { PRICE_FLOOR, CITY_TESTIMONIALS_ENABLED } from '../../../data/booking.js';
import Layout from '../../../layouts/Layout.astro';
import SiteFooter from '../../../components/SiteFooter.astro';
import { cities, getCitySlugs } from '../../../data/cities.js';
import { services, getServiceSlugs } from '../../../data/services.js';
import { businessNode } from '../../../data/schemaBusiness.js';
import { pickPhotos, buildAlt } from '../../../data/photos.js';
import {
  comboIntro,
  comboLocalNotes,
  comboFaqs,
  comboMeta,
  faqSchema,
  nearestCities,
} from '../../../data/comboContent.js';

export function getStaticPaths() {
  const paths = [];
  for (const citySlug of getCitySlugs()) {
    for (const serviceSlug of getServiceSlugs()) {
      paths.push({
        params: { citySlug, serviceSlug },
        props: { city: cities[citySlug], service: services[serviceSlug], citySlug, serviceSlug },
      });
    }
  }
  return paths;
}

const { city, service, citySlug, serviceSlug } = Astro.props;
const phoneDisplay = '(952) 232-5107';
const smsLink = 'sms:+19522325107';
const canonical = `https://dakotavalleyjunkremovalservice.com/cities/${citySlug}/${serviceSlug}/`;
const { title, description } = comboMeta(city, service, citySlug, serviceSlug);
const intro = comboIntro(city, service, citySlug, serviceSlug);
const localNotes = comboLocalNotes(city, service, citySlug, serviceSlug);
const faqs = comboFaqs(city, service, citySlug, serviceSlug);
const ctaSms = `${smsLink}?&body=${encodeURIComponent(`${service.name} request for ${city.name}, MN.\nPlease send photos and item details.`)}`;

const otherServices = Object.entries(services).filter(([sl]) => sl !== serviceSlug);
const otherCities = nearestCities(citySlug, 12).map((sl) => [sl, cities[sl]]);

// Same photos as the city page, but with combo-specific alt text
const comboPhotos = pickPhotos(citySlug, 2);
const heroPhoto = comboPhotos[0];

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    businessNode,
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://dakotavalleyjunkremovalservice.com/' },
        { '@type': 'ListItem', position: 2, name: `${city.name}, MN`, item: `https://dakotavalleyjunkremovalservice.com/cities/${citySlug}/` },
        { '@type': 'ListItem', position: 3, name: service.name },
      ],
    },
    {
      '@type': 'Service',
      name: `${service.name} in ${city.name}, MN`,
      provider: { '@id': 'https://dakotavalleyjunkremovalservice.com/#business' },
      areaServed: {
        '@type': 'City',
        name: city.name,
        containedIn: { '@type': 'AdministrativeArea', name: city.county },
      },
      description,
      serviceType: service.name,
      hasOfferCatalog: {
        '@type': 'OfferCatalog',
        name: `${service.name} options in ${city.name}`,
        itemListElement: service.services.map((s) => ({
          '@type': 'Offer',
          itemOffered: { '@type': 'Service', name: s },
        })),
      },
    },
    faqSchema(faqs),
  ],
};
---
<Layout title={title} description={description} canonical={canonical} schema={schema}>
  <main>
    <section class="city-hero">
      <nav class="nav" aria-label="Primary navigation">
        <a class="brand" href="/">
          <span class="brand-mark"><Icon name="lucide:truck" size={22} /></span>
          <span>Dakota Valley</span>
        </a>
        <a class="nav-call" href={smsLink}><Icon name="lucide:message-square-text" size={18} /> Text {phoneDisplay}</a>
      </nav>

      <div class="city-hero-content">
        <p class="breadcrumb">
          <a href="/">Home</a>
          <span aria-hidden="true"> / </span>
          <a href={`/cities/${citySlug}/`}>{city.name}, MN</a>
          <span aria-hidden="true"> / </span>
          <span>{service.name}</span>
        </p>
        <h1>
          <span class="city-accent">{service.name}</span> in {city.name}, MN
        </h1>
        <p class="hero-copy">{intro}</p>
        <div class="hero-actions">
          <a class="button primary" href={ctaSms}><Icon name="lucide:message-square-text" size={18} /> Text photos to start</a>
          <span class="price-floor"><Icon name="lucide:tag" size={14} />{PRICE_FLOOR}</span>
          <a class="button secondary" href="/#quote"><Icon name="lucide:camera" size={18} /> Use the quote helper</a>
        </div>
        <p class="hero-meta">
          <Icon name="lucide:map-pin" size={15} /> {city.county} &middot; Loads from $85 &middot; Curbside and garage pickup
        </p>
      </div>
    </section>

    <figure class="city-hero-image">
      <img
        src={heroPhoto.src}
        width={heroPhoto.width}
        height={heroPhoto.height}
        alt={buildAlt(heroPhoto.desc, city.name, service.name)}
        loading="eager"
        fetchpriority="high"
      />
      <figcaption>{buildAlt(heroPhoto.desc, city.name, service.name)}</figcaption>
    </figure>

    <section class="section city-services">
      <div class="section-head">
        <div>
          <p class="section-kicker">{service.name} in {city.name}</p>
          <h2>What we include</h2>
        </div>
      </div>
      <div class="city-service-grid">
        {service.services.map((s) => (
          <article class="city-service-card">
            <span class="city-service-icon"><Icon name="lucide:check-circle-2" size={20} /></span>
            <h3>{s}</h3>
          </article>
        ))}
      </div>
    </section>

    <section class="section">
      <div class="section-head">
        <div>
          <p class="section-kicker">{city.name} pickup process</p>
          <h2>Four steps, mostly text.</h2>
        </div>
      </div>
      <div class="city-service-grid">
        {service.process.map((step, i) => (
          <article class="city-service-card">
            <span class="city-service-icon">{i + 1}</span>
            <h3>Step {i + 1}</h3>
            <p>{step}</p>
          </article>
        ))}
      </div>
    </section>

    <section class="section city-locale">
      <div class="section-head">
        <div>
          <p class="section-kicker">{city.name} coverage</p>
          <h2>Routes covering every neighborhood.</h2>
        </div>
      </div>
      <p class="section-copy" style="margin-bottom: 24px">{localNotes}</p>
      <div class="city-locale-grid">
        <div>
          <h3 class="city-list-title">{city.name} neighborhoods we serve</h3>
          <ul class="city-list">
            {city.neighborhoods.map((n) => <li><Icon name="lucide:check" size={14} /> {n}</li>)}
          </ul>
        </div>
        <div>
          <h3 class="city-list-title">Nearby landmarks</h3>
          <ul class="city-list">
            {city.landmarks.map((l) => <li><Icon name="lucide:map-pin" size={14} /> {l}</li>)}
          </ul>
        </div>
      </div>
    </section>

    {CITY_TESTIMONIALS_ENABLED && city.testimonial && (
      <section class="section city-testimonial">
        <blockquote>
          <p>&ldquo;{city.testimonial.text}&rdquo;</p>
          <footer>
            <strong>{city.testimonial.name}</strong>
            <span>{city.testimonial.location}</span>
          </footer>
        </blockquote>
      </section>
    )}

    <section class="section">
      <div class="section-head">
        <div>
          <p class="section-kicker">{service.name} FAQ</p>
          <h2>{city.name} questions, answered.</h2>
        </div>
      </div>
      <div class="faq-list">
        {faqs.map(({ q, a }, index) => (
          <details class="faq-card" open={index === 0}>
            <summary>{q}</summary>
            <p>{a}</p>
          </details>
        ))}
      </div>
    </section>

    <section class="section city-locale">
      <div class="section-head">
        <div>
          <p class="section-kicker">Other services in {city.name}</p>
          <h2>What else we haul.</h2>
        </div>
      </div>
      <div class="city-grid">
        {otherServices.map(([sl, s]) => (
          <a href={`/cities/${citySlug}/${sl}/`} class="city-link">{s.name}</a>
        ))}
        <a href={`/cities/${citySlug}/`} class="city-link">All services in {city.name}</a>
      </div>
    </section>

    <section class="section city-locale">
      <div class="section-head">
        <div>
          <p class="section-kicker">{service.name} in other cities</p>
          <h2>We also serve…</h2>
        </div>
      </div>
      <div class="city-grid">
        {otherCities.map(([sl, c]) => (
          <a href={`/cities/${sl}/${serviceSlug}/`} class="city-link">{c.name}</a>
        ))}
        <a href={`/services/${serviceSlug}/`} class="city-link">See all cities</a>
      </div>
    </section>

    <section class="section city-cta">
      <div>
        <h2>Need {service.name.toLowerCase()} in {city.name}?</h2>
        <p>Text photos, item details, and a preferred calendar window. Crew confirms within a few hours.</p>
      </div>
      <div class="hero-actions">
        <a class="button primary" href={ctaSms}><Icon name="lucide:message-square-text" size={18} /> Text {phoneDisplay}</a>
          <span class="price-floor"><Icon name="lucide:tag" size={14} />{PRICE_FLOOR}</span>
        <a class="button secondary" href="/#quote">Use the quote helper</a>
      </div>
    </section>

    <SiteFooter />

    <div class="mobile-cta" aria-label="Mobile contact actions">
      <a class="button primary" href={ctaSms}>Text</a>
      <a class="button secondary" href="/#quote">Book</a>
    </div>
  </main>
</Layout>
