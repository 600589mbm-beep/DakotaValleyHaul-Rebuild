---
import { Icon } from 'astro-icon/components';
import { PRICE_FLOOR } from '../data/booking.js';
import Layout from '../layouts/Layout.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { businessNode } from '../data/schemaBusiness.js';
import reviewsData from '../data/reviews.json';

const phoneDisplay = '(952) 232-5107';
const smsLink = 'sms:+19522325107';
const site = 'https://dakotavalleyjunkremovalservice.com';
const canonical = `${site}/reviews/`;
const allReviews = reviewsData.reviews || [];
const googleReviews = allReviews.filter((review) => review.platform === 'google');
const yelpReview = allReviews.find((review) => review.platform === 'yelp');
const aggregate = reviewsData.aggregate || { ratingValue: 5, reviewCount: googleReviews.length };
const totalVerified = aggregate.totalVerifiedReviewCount || allReviews.length;

// Reviews are displayed as verified third-party content, but are intentionally
// not attached to LocalBusiness as Review/AggregateRating schema. Google does
// not award self-serving LocalBusiness review snippets for reviews published on
// the reviewed business's own website.
const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    businessNode,
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Home', item: `${site}/` },
        { '@type': 'ListItem', position: 2, name: 'Customer reviews' },
      ],
    },
    {
      '@type': 'CollectionPage',
      '@id': `${canonical}#page`,
      url: canonical,
      name: 'Customer Reviews for Dakota Valley Junk Removal',
      description: `${aggregate.ratingValue.toFixed(1)} stars from ${aggregate.reviewCount} Google reviews, plus a verified Yelp review.`,
      about: { '@id': businessNode['@id'] },
    },
  ],
};
---
<Layout
  title="Customer Reviews | Dakota Valley Junk Removal"
  description={`Read ${totalVerified} verified third-party customer reviews for Dakota Valley Junk Removal: ${aggregate.ratingValue.toFixed(1)} stars from ${aggregate.reviewCount} Google reviews plus a Yelp review.`}
  canonical={canonical}
  schema={schema}
>
  <main>
    <section class="city-hero">
      <nav class="nav" aria-label="Primary navigation">
        <a class="brand" href="/"><span class="brand-mark"><Icon name="lucide:truck" size={22} /></span><span>Dakota Valley</span></a>
        <a class="nav-call" href={smsLink} data-track="sms_click"><Icon name="lucide:message-square-text" size={18} /> Text {phoneDisplay}</a>
      </nav>
      <div class="city-hero-content">
        <p class="breadcrumb"><a href="/">Home</a> <span> / </span><span>Customer reviews</span></p>
        <h1>Real reviews from <span class="city-accent">real customers.</span></h1>
        <p class="hero-copy"><strong>{aggregate.ratingValue.toFixed(1)} stars from {aggregate.reviewCount} Google reviews</strong>, plus a verified Yelp review. Customers consistently mention fair prices, fast service, clear communication, and easy scheduling.</p>
        <div class="hero-actions">
          <a class="button primary" href={smsLink} data-track="sms_click"><Icon name="lucide:message-square-text" size={18} /> Text for a quote</a>
          <span class="price-floor"><Icon name="lucide:tag" size={14} />{PRICE_FLOOR}</span>
          <a class="button secondary" href="/#quote"><Icon name="lucide:camera" size={18} /> Use the quote helper</a>
        </div>
      </div>
    </section>

    <section class="section" aria-labelledby="google-reviews-heading">
      <div class="section-head"><div>
        <p class="section-kicker">Google reviews</p>
        <h2 id="google-reviews-heading">{aggregate.ratingValue.toFixed(1)}★ from {aggregate.reviewCount} customers.</h2>
      </div>
        <p class="section-copy">These are the verified Google reviews currently associated with Dakota Valley Junk Removal.</p>
      </div>

      <div class="city-service-grid">
        {googleReviews.map((review) => (
          <article class="city-service-card">
            <div class="testimonial-stars" aria-label={`${review.rating} out of 5 stars`}>{'★'.repeat(review.rating)}</div>
            <p class="testimonial-text">&ldquo;{review.text}&rdquo;</p>
            <div class="testimonial-who">
              <strong>{review.author}</strong>
              <span>Google review{review.publishedLabel ? ` · ${review.publishedLabel}` : ''}</span>
            </div>
          </article>
        ))}
      </div>
    </section>

    {yelpReview && (
      <section class="section" aria-labelledby="yelp-review-heading">
        <div class="section-head"><div>
          <p class="section-kicker">Yelp review</p>
          <h2 id="yelp-review-heading">Also reviewed on Yelp.</h2>
        </div>
          <p class="section-copy">The official Yelp widget below preserves the original attribution and links directly to the review.</p>
        </div>

        <div class="city-service-card" style="max-width:760px">
          <span class="yelp-review" data-review-id="_hmoQfdYaa-g-ZSO4Ybv1g" data-hostname="www.yelp.com">
            Read <a href="https://www.yelp.com/user_details?userid=25QWYxtPkYvu99dhVaDvsQ" rel="nofollow noopener">J J.</a>'s
            <a href="https://www.yelp.com/biz/dakota-valley-junk-removal-saint-paul?hrid=_hmoQfdYaa-g-ZSO4Ybv1g" rel="nofollow noopener">review</a> of
            <a href="https://www.yelp.com/biz/DBq3EYpC3duRqtt6E3kdZQ" rel="nofollow noopener">Dakota Valley Junk Removal</a> on
            <a href="https://www.yelp.com" rel="nofollow noopener">Yelp</a>
          </span>
          <script is:inline src="https://www.yelp.com/embed/widgets.js" type="text/javascript" async></script>
        </div>
      </section>
    )}

    <section class="section city-cta">
      <div>
        <h2>Ready for the same straightforward service?</h2>
        <p>Text photos for a written quote, approve the total, and choose an available pickup window.</p>
      </div>
      <div class="hero-actions">
        <a class="button primary" href={smsLink} data-track="sms_click"><Icon name="lucide:message-square-text" size={18} /> Text {phoneDisplay}</a>
        <span class="price-floor"><Icon name="lucide:tag" size={14} />{PRICE_FLOOR}</span>
        <a class="button secondary" href="/#quote">Use the quote helper</a>
      </div>
    </section>

    <SiteFooter />
    <div class="mobile-cta">
      <a class="button primary" href={smsLink} data-track="sms_click">Text</a>
      <a class="button secondary" href="/#quote">Book</a>
    </div>
  </main>
</Layout>
