---
import { Icon } from 'astro-icon/components';
import { PRICE_FLOOR } from '../data/booking.js';
import Layout from '../layouts/Layout.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { cities } from '../data/cities.js';
import { businessNode } from '../data/schemaBusiness.js';
import reviewsData from '../data/reviews.json';

const phoneDisplay = '(952) 232-5107';
const smsLink = 'sms:+19522325107';
const site = 'https://dakotavalleyjunkremovalservice.com';
const canonical = `${site}/reviews/`;

const allReviews = Object.entries(cities)
  .filter(([, c]) => c.testimonial)
  .map(([slug, c]) => ({ slug, city: c.name, ...c.testimonial }));

// Same policy as the homepage: Review/AggregateRating markup ONLY when the
// review source is verified (Google). Site-sourced testimonials render as
// content but are never asserted as schema.org reviews.
const verifiedReviewMarkup = reviewsData.source === 'google'
  ? {
      aggregateRating: {
        '@type': 'AggregateRating',
        ratingValue: reviewsData.aggregate.ratingValue.toFixed(1),
        reviewCount: String(reviewsData.aggregate.reviewCount),
        bestRating: '5',
      },
      review: (reviewsData.reviews || []).slice(0, 12).map((r) => ({
        '@type': 'Review',
        reviewRating: { '@type': 'Rating', ratingValue: String(r.rating || 5), bestRating: '5' },
        author: { '@type': 'Person', name: r.author },
        reviewBody: r.text,
      })),
    }
  : {};

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    { ...businessNode, ...verifiedReviewMarkup },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Home', item: `${site}/` },
        { '@type': 'ListItem', position: 2, name: 'Reviews' },
      ],
    },
    {
      '@type': 'CollectionPage',
      '@id': `${canonical}#page`,
      url: canonical,
      name: 'Reviews from Across Minnesota',
      description: `Customer testimonials from the ${allReviews.length} Minnesota cities Dakota Valley serves.`,
      about: { '@id': businessNode['@id'] },
    },
  ],
};
---
<Layout
  title="Reviews from Across Minnesota | Dakota Valley Junk Removal"
  description={`Customer reviews from across the ${allReviews.length} Minnesota cities Dakota Valley serves. Real testimonials from real Minnesota neighborhoods.`}
  canonical={canonical}
  schema={schema}
>
  <main>
    <section class="city-hero">
      <nav class="nav"><a class="brand" href="/"><span class="brand-mark"><Icon name="lucide:truck" size={22} /></span><span>Dakota Valley</span></a>
        <a class="nav-call" href={smsLink}><Icon name="lucide:message-square-text" size={18} /> Text {phoneDisplay}</a></nav>
      <div class="city-hero-content">
        <p class="breadcrumb"><a href="/">Home</a> <span> / </span><span>Reviews</span></p>
        <h1>What <span class="city-accent">Minnesotans</span> are saying.</h1>
        <p class="hero-copy">Real reviews from real Minnesota neighborhoods. Click into any city for that city's full landing page.</p>
        <div class="hero-actions">
          <a class="button primary" href={smsLink}><Icon name="lucide:message-square-text" size={18} /> Text for a quote</a>
          <span class="price-floor"><Icon name="lucide:tag" size={14} />{PRICE_FLOOR}</span>
          <a class="button secondary" href="/#quote"><Icon name="lucide:camera" size={18} /> Use the quote helper</a>
        </div>
      </div>
    </section>

    <section class="section">
      <div class="section-head"><div>
        <p class="section-kicker">{allReviews.length} reviews across Minnesota</p>
        <h2>From {allReviews[0]?.city} to {allReviews[allReviews.length - 1]?.city}.</h2>
      </div></div>
      <div class="city-service-grid">
        {allReviews.map((r) => (
          <article class="city-service-card">
            <div style="display: flex; gap: 2px; margin-bottom: 10px; color: #f5b401">★★★★★</div>
            <p style="font-size: 15px; line-height: 1.5; color: var(--ink); margin-bottom: 14px">&ldquo;{r.text}&rdquo;</p>
            <div>
              <strong style="display: block; color: var(--ink)">{r.name}</strong>
              <span style="color: var(--muted); font-size: 13px">{r.location}</span>
            </div>
            <a href={`/cities/${r.slug}/`} style="display: inline-block; margin-top: 10px; color: var(--blue); font-size: 13px; font-weight: 800; text-decoration: none">
              {r.city} pickup details →
            </a>
          </article>
        ))}
      </div>
    </section>

    <section class="section city-cta">
      <div>
        <h2>Ready to add yours?</h2>
        <p>Text photos for a quote. Once the job is done, the crew will share a link to leave a review.</p>
      </div>
      <div class="hero-actions">
        <a class="button primary" href={smsLink}><Icon name="lucide:message-square-text" size={18} /> Text {phoneDisplay}</a>
          <span class="price-floor"><Icon name="lucide:tag" size={14} />{PRICE_FLOOR}</span>
        <a class="button secondary" href="/#quote">Use the quote helper</a>
      </div>
    </section>

    <SiteFooter />
    <div class="mobile-cta">
      <a class="button primary" href={smsLink}>Text</a>
      <a class="button secondary" href="/#quote">Book</a>
    </div>
  </main>
</Layout>
