---
import { Icon } from 'astro-icon/components';
import { PRICE_FLOOR } from '../data/booking.js';
import Layout from '../layouts/Layout.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { businessNode } from '../data/schemaBusiness.js';
import reviewsData from '../data/reviews.json';

const phoneDisplay = '(952) 232-5107';
const smsLink = 'sms:+19522325107';
const site = 'https://dakotavalleyjunkremovalservice.com';
const canonical = `${site}/reviews/`;
const allReviews = reviewsData.reviews || [];
const agg = reviewsData.aggregate || {
  ratingValue: 5,
  reviewCount: 0,
  totalVerifiedCount: allReviews.length,
  googleReviewCount: 0,
  yelpReviewCount: 0,
};
const totalVerified = agg.totalVerifiedCount || allReviews.length;

// Reviews are displayed as visible customer proof. We intentionally do not add
// Review or AggregateRating markup to Dakota Valley's own LocalBusiness entity.
const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    businessNode,
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Home', item: `${site}/` },
        { '@type': 'ListItem', position: 2, name: 'Customer reviews', item: canonical },
      ],
    },
    {
      '@type': 'CollectionPage',
      '@id': `${canonical}#page`,
      url: canonical,
      name: 'Customer Reviews for Dakota Valley Junk Removal',
      description: `${totalVerified} verified third-party customer reviews for Dakota Valley Junk Removal, including ${agg.googleReviewCount || agg.reviewCount} Google reviews and ${agg.yelpReviewCount || 0} Yelp review.`,
      about: { '@id': businessNode['@id'] },
      inLanguage: 'en-US',
    },
  ],
};
---
<Layout
  title="Customer Reviews | Dakota Valley Junk Removal"
  description={`Read ${totalVerified} verified customer reviews for Dakota Valley Junk Removal. Rated ${agg.ratingValue.toFixed(1)} from ${agg.googleReviewCount || agg.reviewCount} Google reviews and also reviewed on Yelp.`}
  canonical={canonical}
  schema={schema}
>
  <main>
    <section class="city-hero">
      <nav class="nav"><a class="brand" href="/"><span class="brand-mark"><Icon name="lucide:truck" size={22} /></span><span>Dakota Valley</span></a>
        <a class="nav-call" href={smsLink}><Icon name="lucide:message-square-text" size={18} /> Text {phoneDisplay}</a></nav>
      <div class="city-hero-content">
        <p class="breadcrumb"><a href="/">Home</a> <span> / </span><span>Reviews</span></p>
        <h1>Real reviews from <span class="city-accent">real customers.</span></h1>
        <p class="hero-copy">Dakota Valley Junk Removal is rated {agg.ratingValue.toFixed(1)} out of 5 from {agg.googleReviewCount || agg.reviewCount} Google reviews and is also reviewed on Yelp. Customers consistently mention fair pricing, fast pickups, friendly service, and clear communication.</p>
        <div class="hero-actions">
          <a class="button primary" href={smsLink}><Icon name="lucide:message-square-text" size={18} /> Text for a quote</a>
          <span class="price-floor"><Icon name="lucide:tag" size={14} />{PRICE_FLOOR}</span>
          <a class="button secondary" href="/#quote"><Icon name="lucide:camera" size={18} /> Use the quote helper</a>
        </div>
      </div>
    </section>

    <section class="section">
      <div class="section-head"><div>
        <p class="section-kicker">{totalVerified} verified third-party reviews</p>
        <h2>{agg.ratingValue.toFixed(1)}★ on Google · Also reviewed on Yelp</h2>
      </div>
        <p class="section-copy">Only reviews supplied from verified Google and Yelp listings are shown here.</p>
      </div>

      <div class="city-service-grid">
        {allReviews.map((r) => (
          <article class="city-service-card">
            {typeof r.rating === 'number' ? (
              <div style="display:flex;gap:2px;margin-bottom:10px;color:#f5b401" aria-label={`${r.rating} out of 5 stars`}>{'★'.repeat(r.rating)}</div>
            ) : (
              <div style="margin-bottom:10px;color:#d32323;font-weight:800">Yelp review</div>
            )}
            <p style="font-size:15px;line-height:1.6;color:var(--ink);margin-bottom:14px">&ldquo;{r.text}&rdquo;</p>
            <div>
              <strong style="display:block;color:var(--ink)">{r.author}</strong>
              <span style="color:var(--muted);font-size:13px">{[r.location, r.platform, r.publishedAt].filter(Boolean).join(' · ')}</span>
            </div>
            {r.reviewUrl && (
              <a href={r.reviewUrl} rel="nofollow noopener" target="_blank" style="display:inline-block;margin-top:10px;color:var(--blue);font-size:13px;font-weight:800;text-decoration:none">
                Read the original on {r.platform} →
              </a>
            )}
          </article>
        ))}
      </div>
    </section>

    <section class="section city-cta">
      <div>
        <h2>Ready for an easy pickup?</h2>
        <p>Text photos for a written quote. Once the job is complete, we appreciate an honest Google or Yelp review.</p>
      </div>
      <div class="hero-actions">
        <a class="button primary" href={smsLink}><Icon name="lucide:message-square-text" size={18} /> Text {phoneDisplay}</a>
        <span class="price-floor"><Icon name="lucide:tag" size={14} />{PRICE_FLOOR}</span>
        <a class="button secondary" href="/#quote">Use the quote helper</a>
      </div>
    </section>

    <SiteFooter />
    <div class="mobile-cta">
      <a class="button primary" href={smsLink}>Text</a>
      <a class="button secondary" href="/#quote">Book</a>
    </div>
  </main>
</Layout>
