---
import '../styles.css';

export interface Props {
  title: string;
  description: string;
  canonical: string;
  ogImage?: string;
  schema?: object | object[];
  noindex?: boolean;
}

const {
  title,
  description,
  canonical,
  ogImage = 'https://dakotavalleyjunkremovalservice.com/attached_assets/IMG_7020_1750653174383.jpeg',
  schema,
  noindex = false,
} = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="color-scheme" content="light only" />
    <meta name="theme-color" content="#0957c3" />
    <meta name="format-detection" content="telephone=yes,email=yes,address=no" />
    {noindex
      ? <meta name="robots" content="noindex, nofollow" />
      : <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />}
    <meta name="googlebot" content="index, follow" />

    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content="Dakota Valley Junk Removal" />
    <link rel="canonical" href={canonical} />

    <!-- OpenGraph -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="Dakota Valley Junk Removal" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:alt" content="Dakota Valley Junk Removal truck and crew" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="900" />

    <!-- Twitter / X -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:url" content={canonical} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content="Dakota Valley Junk Removal truck and crew" />

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/favicon.svg" />
    <meta name="apple-mobile-web-app-title" content="Dakota Valley" />

    <!-- Geo -->
    <meta name="geo.region" content="US-MN" />
    <meta name="geo.placename" content="Minnesota" />
    <meta name="geo.position" content="44.97;-93.27" />
    <meta name="ICBM" content="44.97, -93.27" />

    {schema && (
      <script type="application/ld+json" set:html={JSON.stringify(schema)}></script>
    )}
  </head>
  <body>
    <slot />
  </body>
</html>
