---
import '../styles.css';
import '../header-logo.css';
import { META_PIXEL_ID } from '../data/tracking.js';
import LeadTracking from '../components/LeadTracking.astro';

export interface Props {
  title: string;
  description: string;
  canonical: string;
  ogImage?: string;
  schema?: object | object[];
  noindex?: boolean;
}

const {
  title,
  description,
  canonical,
  ogImage = 'https://dakotavalleyjunkremovalservice.com/og-card.png',
  schema,
  noindex = false,
} = Astro.props;
const nodes = Array.isArray(schema) ? schema : (schema as any)?.['@graph'] || [schema];
const article = nodes.find((node: any) => node?.['@type'] === 'Article');
const imageAlt = 'Dakota Valley Junk Removal — written photo quotes for staged pickup';
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="color-scheme" content="light only" />
    <meta name="theme-color" content="#0c2748" />
    <meta name="format-detection" content="telephone=yes,email=yes,address=no" />
    {noindex
      ? <meta name="robots" content="noindex, nofollow" />
      : <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />}
    <meta name="googlebot" content={noindex ? 'noindex, nofollow' : 'index, follow'} />

    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content="Dakota Valley Junk Removal" />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="en-us" href={canonical} />
    <link rel="alternate" hreflang="x-default" href={canonical} />

    <!-- OpenGraph -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={article ? 'article' : 'website'} />
    {article?.datePublished && <meta property="article:published_time" content={article.datePublished} />}
    {article?.dateModified && <meta property="article:modified_time" content={article.dateModified} />}
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="Dakota Valley Junk Removal" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:alt" content={imageAlt} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:type" content="image/png" />

    <!-- Twitter / X -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:url" content={canonical} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={imageAlt} />
    <meta name="twitter:label1" content="Pricing" />
    <meta name="twitter:data1" content="Written photo quote" />
    <meta name="twitter:label2" content="Service area" />
    <meta name="twitter:data2" content="Minnesota — confirm availability for your address" />

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/favicon.svg" />
    <meta name="apple-mobile-web-app-title" content="Dakota Valley" />

    <!-- Fonts: Anton (display) + Figtree (body) + Spline Sans Mono (accents) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Anton&family=Figtree:wght@400;500;600;700;800;900&family=Spline+Sans+Mono:wght@400;500;600&display=swap" rel="stylesheet" />

    <!-- Geo -->
    <meta name="geo.region" content="US-MN" />
    <meta name="geo.placename" content="Minnesota" />

    <!-- Start ordinary page visits at the top. Preserve intentional section links such as /#quote. -->
    <script is:inline>
      (function () {
        if ('scrollRestoration' in window.history) {
          window.history.scrollRestoration = 'manual';
        }

        function startAtTop() {
          if (window.location.hash) return;
          window.scrollTo(0, 0);
          window.requestAnimationFrame(function () {
            window.scrollTo(0, 0);
          });
        }

        startAtTop();
        document.addEventListener('DOMContentLoaded', startAtTop, { once: true });
        window.addEventListener('load', startAtTop, { once: true });
        window.addEventListener('pageshow', startAtTop);
      })();
    </script>

    {schema && (
      <script type="application/ld+json" set:html={JSON.stringify(schema)}></script>
    )}

    <!-- Meta Pixel -->
    <script define:vars={{ metaPixelId: META_PIXEL_ID }}>
      !(function (f, b, e, v, n, t, s) {
        if (f.fbq) return;
        n = f.fbq = function () {
          n.callMethod ? n.callMethod.apply(n, arguments) : n.queue.push(arguments);
        };
        if (!f._fbq) f._fbq = n;
        n.push = n;
        n.loaded = true;
        n.version = '2.0';
        n.queue = [];
        t = b.createElement(e);
        t.async = true;
        t.src = v;
        s = b.getElementsByTagName(e)[0];
        s.parentNode.insertBefore(t, s);
      })(window, document, 'script', 'https://connect.facebook.net/en_US/fbevents.js');
      fbq('init', metaPixelId);
      fbq('track', 'PageView');
    </script>
    <noscript>
      <img height="1" width="1" style="display:none" alt="" src={`https://www.facebook.com/tr?id=${META_PIXEL_ID}&ev=PageView&noscript=1`} />
    </noscript>

      <!-- Google AdSense -->
    <script is:inline async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-3232938629505810" crossorigin="anonymous"></script>
</head>
  <body id="top">
    <slot />

    <LeadTracking />
  </body>
</html>
