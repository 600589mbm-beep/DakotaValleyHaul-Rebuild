---
import '../styles.css';

export interface Props {
  title: string;
  description: string;
  canonical: string;
  ogImage?: string;
  schema?: object | object[];
  noindex?: boolean;
}

const {
  title,
  description,
  canonical,
  ogImage = 'https://dakotavalleyjunkremovalservice.com/og-card.png',
  schema,
  noindex = false,
} = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="color-scheme" content="light only" />
    <meta name="theme-color" content="#0957c3" />
    <meta name="format-detection" content="telephone=yes,email=yes,address=no" />
    {noindex
      ? <meta name="robots" content="noindex, nofollow" />
      : <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />}
    <meta name="googlebot" content="index, follow" />

    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content="Dakota Valley Junk Removal" />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="en-us" href={canonical} />
    <link rel="alternate" hreflang="x-default" href={canonical} />

    <!-- OpenGraph -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="Dakota Valley Junk Removal" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:alt" content="Dakota Valley Junk Removal — curbside & garage pickup across Minnesota, $85 minimum" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:type" content="image/png" />

    <!-- Twitter / X -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:url" content={canonical} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content="Dakota Valley Junk Removal truck and crew" />
    <meta name="twitter:label1" content="Pricing" />
    <meta name="twitter:data1" content="From $85" />
    <meta name="twitter:label2" content="Service area" />
    <meta name="twitter:data2" content="Minnesota — Twin Cities metro & statewide" />

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/favicon.svg" />
    <meta name="apple-mobile-web-app-title" content="Dakota Valley" />

    <!-- Geo -->
    <meta name="geo.region" content="US-MN" />
    <meta name="geo.placename" content="Minnesota" />
    <meta name="geo.position" content="44.97;-93.27" />
    <meta name="ICBM" content="44.97, -93.27" />

    {schema && (
      <script type="application/ld+json" set:html={JSON.stringify(schema)}></script>
    )}
  </head>
  <body>
    <slot />

    <!-- Lightweight analytics dispatcher. Vendor-agnostic: pushes to
         window.dataLayer (GA/GTM), fires a CustomEvent, and is a no-op-safe
         global. Wire GA4/Plausible later by reading dvq events or dataLayer. -->
    <script is:inline>
      (function () {
        window.dataLayer = window.dataLayer || [];
        window.dvTrack = function (event, props) {
          var payload = Object.assign({ event: 'dv_' + event }, props || {});
          window.dataLayer.push(payload);
          try { window.dispatchEvent(new CustomEvent('dv:' + event, { detail: props || {} })); } catch (e) {}
          if (window.gtag) window.gtag('event', event, props || {});
        };
        document.addEventListener('click', function (e) {
          var a = e.target.closest && e.target.closest('a[href], [data-track]');
          if (!a) return;
          var named = a.getAttribute('data-track');
          if (named) { window.dvTrack(named, { href: a.getAttribute('href') || undefined }); return; }
          var href = a.getAttribute('href') || '';
          if (href.indexOf('sms:') === 0) window.dvTrack('sms_click', { href: href });
          else if (href.indexOf('tel:') === 0) window.dvTrack('phone_click', { href: href });
        }, true);
        var pv = document.getElementById('pricing-preview');
        if (pv && 'IntersectionObserver' in window) {
          var seen = false;
          var io = new IntersectionObserver(function (entries) {
            entries.forEach(function (en) {
              if (en.isIntersecting && !seen) { seen = true; window.dvTrack('pricing_view', {}); io.disconnect(); }
            });
          }, { threshold: 0.4 });
          io.observe(pv);
        }
      })();
    </script>
  </body>
</html>
