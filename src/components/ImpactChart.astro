---
// "Where your junk actually goes" — destination routing, no landfill row.
// Owner direction 2026-06-11: we don't landfill, so the old donated/
// recycled/landfill percentage chart (placeholder numbers) is gone.
// No invented percentages or tonnage — only the real routing chains.
const destinations = [
  {
    label: 'Donated',
    color: '#0957c3',
    desc: 'Usable furniture and household goods go to Bridging, Arc’s Value Village, and Savers.',
  },
  {
    label: 'Recycled',
    color: '#3b82d9',
    desc: 'Metal to certified recyclers, electronics to R2-certified e-waste facilities, mattresses to certified Minnesota mattress recycling.',
  },
  {
    label: 'Composted',
    color: '#2f9e6e',
    desc: 'Brush, branches, and compostable yard material routed to certified compost facilities.',
  },
];
---
<section class="section impact" id="impact" aria-label="Where your junk goes">
  <div class="section-head"><div>
    <p class="section-kicker">Where your junk goes</p>
    <h2>Donated, recycled, composted — not dumped.</h2>
  </div>
    <p class="section-copy">
      Every load gets sorted by destination instead of heading to a landfill. Tell the crew which items are
      donation candidates and they route them with the rest.
    </p>
  </div>

  <div class="impact-chart">
    {destinations.map((d) => (
      <div class="impact-row" style="grid-template-columns: 110px 1fr">
        <span class="impact-row-label" style={`color:${d.color}`}>{d.label}</span>
        <p style="margin:0;color:var(--muted);line-height:1.6">{d.desc}</p>
      </div>
    ))}
  </div>
</section>
