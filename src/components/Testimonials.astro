---
// Server-rendered, crawlable review carousel using only verified third-party
// reviews supplied by the business owner or refreshed from Google Places.
import reviewsData from '../data/reviews.json';

const { count = 9 } = Astro.props;
const verified = reviewsData.source === 'google' || reviewsData.source === 'verified-third-party';
const all = reviewsData.reviews || [];
const shown = all.slice(0, count);
const agg = reviewsData.aggregate || {
  ratingValue: 5.0,
  reviewCount: 0,
  totalVerifiedCount: all.length,
  googleReviewCount: 0,
  yelpReviewCount: 0,
};
const totalVerified = agg.totalVerifiedCount || all.length;
---
<section class="section testimonials" id="reviews" aria-label="Customer reviews">
  {verified && all.length ? (
    <Fragment>
      <div class="section-head"><div>
        <p class="section-kicker">Verified customer reviews</p>
        <h2>{agg.ratingValue.toFixed(1)}★ from {agg.googleReviewCount || agg.reviewCount} Google reviews.</h2>
      </div>
        <p class="section-copy">Customers mention fair pricing, fast pickups, friendly service, and clear communication. Also reviewed on Yelp.</p>
      </div>

      <div class="testimonial-track" role="list">
        {shown.map((r) => (
          <article class="testimonial-card" role="listitem">
            {typeof r.rating === 'number' ? (
              <div class="testimonial-stars" aria-label={`${r.rating} out of 5 stars`}>{'★'.repeat(r.rating)}</div>
            ) : (
              <div class="testimonial-stars" aria-label="Verified Yelp review">Yelp review</div>
            )}
            <p class="testimonial-text">&ldquo;{r.text}&rdquo;</p>
            <div class="testimonial-who">
              <strong>{r.author}</strong>
              <span>{[r.location, r.platform].filter(Boolean).join(' · ')}</span>
            </div>
            {r.reviewUrl && (
              <a class="testimonial-link" href={r.reviewUrl} rel="nofollow noopener" target="_blank">Read on {r.platform} →</a>
            )}
          </article>
        ))}
      </div>
      <p class="testimonials-all"><a href="/reviews/" data-track="reviews_click">Read all {totalVerified} verified reviews →</a></p>
    </Fragment>
  ) : (
    <div class="section-head"><div>
      <p class="section-kicker">Reviews</p>
      <h2>Customer reviews</h2>
    </div>
      <p class="section-copy">Read what customers say about Dakota Valley Junk Removal.</p>
    </div>
  )}
</section>
