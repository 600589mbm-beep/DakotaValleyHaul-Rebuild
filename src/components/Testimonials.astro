---
// Server-rendered (crawlable) review carousel. Only verified third-party reviews
// from reviews.json are displayed. Yelp is rendered with its official embed on
// the dedicated reviews page; the homepage carousel focuses on Google reviews.
import reviewsData from '../data/reviews.json';

const { count = 6 } = Astro.props;
const verified = reviewsData.source === 'verified-third-party' || reviewsData.source === 'google';
const all = reviewsData.reviews || [];
const googleReviews = all.filter((review) =>
  review.platform === 'google' || (reviewsData.source === 'google' && !review.platform)
);
const step = Math.max(1, Math.floor(googleReviews.length / count));
const shown = [];
for (let i = 0; i < googleReviews.length && shown.length < count; i += step) shown.push(googleReviews[i]);
const agg = reviewsData.aggregate || { ratingValue: 5.0, reviewCount: googleReviews.length };
const totalVerified = agg.totalVerifiedReviewCount || agg.reviewCount || all.length;
---
<section class="section testimonials" id="reviews" aria-label="Customer reviews">
  {verified && googleReviews.length ? (
    <Fragment>
      <div class="section-head"><div>
        <p class="section-kicker">Verified customer reviews</p>
        <h2>{agg.ratingValue.toFixed(1)}★ from {agg.reviewCount} Google reviews.</h2>
      </div>
        <p class="section-copy">Customers consistently mention fair pricing, fast service, clear communication, and easy scheduling. Dakota Valley is also reviewed on Yelp.</p>
      </div>

      <div class="testimonial-track" role="list">
        {shown.map((r) => (
          <article class="testimonial-card" role="listitem">
            <div class="testimonial-stars" aria-label={`${r.rating} out of 5 stars`}>{'★'.repeat(r.rating)}</div>
            <p class="testimonial-text">&ldquo;{r.text}&rdquo;</p>
            <div class="testimonial-who">
              <strong>{r.author}</strong>
              <span>Google review{r.publishedLabel ? ` · ${r.publishedLabel}` : ''}</span>
            </div>
          </article>
        ))}
      </div>
      <p class="testimonials-all"><a href="/reviews/" data-track="reviews_click">Read all {totalVerified} verified reviews →</a></p>
    </Fragment>
  ) : (
    <div class="section-head"><div>
      <p class="section-kicker">Reviews</p>
      <h2>Customer reviews are being updated.</h2>
    </div>
      <p class="section-copy">Text photos for a written quote and experience Dakota Valley's fast, straightforward service.</p>
    </div>
  )}
</section>
