---
import { Icon } from 'astro-icon/components';
import { CALENDLY_URL } from '../data/booking.js';
---
<div class="booking-widget">
  <p class="booking-trust">
    <Icon name="lucide:calendar-check-2" size={16} />
    Pick a date and time below. The crew arrives during your selected window — no waiting on a callback.
  </p>

  {/* Calendly inline embed — Calendly's widget script loads lazily via async tag */}
  <div
    class="calendly-inline-widget"
    data-url={CALENDLY_URL}
    style="min-width:320px;height:680px;"
  ></div>

  <p class="booking-fallback">
    <Icon name="lucide:message-square-text" size={14} />
    Prefer text? Send photos directly to <a href="sms:+19522325107">(952) 232-5107</a> and the crew will reply with a quote and available windows.
  </p>
</div>

<script src="https://assets.calendly.com/assets/external/widget.js" async></script>
